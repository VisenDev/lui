(defpackage #:lui.tests.gallery
  (:use #:cl #:lui #:lui.layout #:lui.frame #:lui.widgets #:lui.tests.support)
  (:export #:run-tests))
(in-package #:lui.tests.gallery)

(defun test-independent-demos ()
  (let ((first (lui.example.demo:make-demo)) (second
          (lui.example.demo:make-demo))
        (first-context (make-test-context))
        (second-context (make-test-context)) (*unit* 1))
    (labels ((frame (context draw &rest events)
               (with-frame (context 100 60 :events events) (funcall draw)))
             (has-label (context text)
               (let ((found nil))
                 (walk-elements
                  (context-root context)
                  (lambda (node)
                    (let ((widget (element-content node)))
                      (when (and (widget-p widget)
                                 (eq :label (widget-kind widget))
                                 (string= text (widget-text widget)))
                        (setf found t)))))
                 found)))
      (frame first-context first)
      (frame second-context second)
      (frame first-context first
             (make-event :kind :change :id :name :value "Instance A")
             (make-event :kind :activate :id :hello))
      (frame second-context second)
      (assert (has-label first-context "Hello Instance A (1)"))
      (assert (has-label second-context "Hello Common Lisp (0)"))
      ;; Each gallery also owns a separate Seven GUIs state graph.
      (frame first-context first
             (make-event :kind :activate :id '(:page :seven)))
      (frame second-context second
             (make-event :kind :activate :id '(:page :seven)))
      (frame first-context first
             (make-event :kind :activate :id :seven-count))
      (frame first-context first)
      (frame second-context second)
      (assert (has-label first-context "1"))
      (assert (has-label second-context "0")))))

(defun test-header-controls ()
  (let ((context (make-test-context))
        (gallery (lui.example.demo:make-gallery)) (*unit* 1))
    (labels ((frame (&rest events)
               (with-frame (context 100 60 :events events)
                 (lui.example.demo:draw gallery)))
             (control (id)
               (element-content
                 (gethash (lui:widget-id id context) (lui.frame::context-ids
                  context))))
             (toolkit-label (name)
               (let ((found nil))
                 (walk-elements
                  (context-root context)
                  (lambda (node)
                    (let ((widget (element-content node)))
                      (when (and (widget-p widget)
                                 (eq :label (widget-kind widget))
                                 (string= name (widget-text widget)))
                        (setf found t)))))
                 found)))
      (frame)
      (assert (string= "Cycle toolkit" (widget-text (control :toolkit))))
      (assert (string= "Show debugger"
                       (widget-text (control :debugger-toggle))))
      (dolist (style '("Qt" "Glass" "Motif" "Garnet" "macOS" "Qt"))
        (assert (toolkit-label (format nil "Toolkit: ~A" style)))
        (frame (make-event :kind :activate :id :toolkit)))
      (dolist (palette '(:light :dark :ocean :forest :default))
        (frame (make-event :kind :activate :id :palette))
        (assert (eq palette (lui.example.demo::gallery-palette gallery)))
        (assert (toolkit-label (format nil "Palette: ~A" (string-capitalize
                  (symbol-name palette))))))
      (frame (make-event :kind :activate :id :debugger-toggle))
      (assert (lui.debug:debugger-enabled-p context))
      ;; The named action shows the debugger; repeated activation keeps it open.
      (frame (make-event :kind :activate :id :debugger-toggle))
      (assert (lui.debug:debugger-enabled-p context)))))

(defun run-tests ()
  (test-independent-demos)
  (test-header-controls)
  (let ((context (make-test-context))
        (*unit* 1)
        (gallery (lui.example.demo:make-gallery :name "Persistent value")))
    (flet ((frame (&optional events)
             (with-frame (context 100 60 :events events)
               (lui.example.demo:draw gallery))))
      (dolist (style lui.example.demo::*toolkits*)
        (setf (lui.example.demo::gallery-toolkit gallery) style)
        (dolist (page lui.example.demo::*pages*)
          (setf (lui.example.demo::gallery-page gallery) (first page))
          (frame)
          (let* ((window (gethash (lui:widget-id :window context)
                           (lui.frame::context-ids context)))
                 (appearance (element-content window)))
            (assert (= 1 (widget-opacity appearance)))
            (when (eq style :motif)
              (assert (equal "#b8b8b8" (widget-background appearance)))))
          (when (eq (first page) :styles)
            (let* ((nodes (lui.frame::context-ids context))
                   (preview (element-content (gethash (lui:widget-id
                        :style-preview context) nodes))))
              (assert (null (gethash :frost nodes)))
              (assert (null (gethash :opacity nodes)))
              (assert (= 1 (widget-opacity preview)))
              (assert (zerop (widget-frost preview)))
              (assert (visible-text-p context "solid colors"))))
          (let ((tabs 0) (selected 0))
            (walk-elements
             (context-root context)
             (lambda (node)
               (let ((widget (element-content node)))
                 (when (widget-p widget)
                   ;; A whole page, including navigation, uses one toolkit.
                   (assert (eq style (widget-style widget)))
                   (when (and (eq (widget-kind widget) :tab)
                            (consp (lui:widget-key (element-id node)))
                            (eq :page (first (lui:widget-key (element-id
                                  node)))))
                     (incf tabs)
                     (when (widget-value widget) (incf selected)))))))
            (assert (= tabs (length lui.example.demo::*pages*)))
            (assert (= selected 1)))
          (assert (plusp (visible-widget-count context)))))
      ;; Percentage panels fit all wrapped text and shrink again on resize.
      (let ((gallery (lui.example.demo:make-gallery :page :layout :split
                0.3)))
        (dolist (style lui.example.demo::*toolkits*)
          (setf (lui.example.demo::gallery-toolkit gallery) style)
          (let ((wide-height nil))
            (dolist (width '(100 30 100))
              (with-frame (context width 100) (lui.example.demo:draw gallery))
              (let* ((ids (lui.frame::context-ids context))
                     (row (gethash :split-panels ids))
                     (panel (gethash :split-panel ids))
                     (bounds (element-box panel))
                     (height (box-height (element-box row))))
                (if (= width 30)
                    (assert (> height wide-height))
                    (if wide-height
                        (assert (= height wide-height))
                        (setf wide-height height)))
                (do-children (child panel)
                  (let ((box (element-box child)))
                    (multiple-value-bind (text-width text-height)
                        (funcall (element-measure child) (box-width box))
                      (declare (ignore text-width))
                      (assert (= text-height (box-height box))))
                    (assert (<= (+ (box-y box) (box-height box))
                                (- (+ (box-y bounds) (box-height bounds))
                                   (element-padding panel))))))
                (assert (>= (box-y (element-box (gethash (lui:widget-id
                            :align context) ids)))
                            (+ (box-y (element-box row)) height))))))))
      (setf (lui.example.demo::gallery-page gallery) :controls)
      (frame)
      (setf (context-focus context) (lui:widget-id '(:page :controls)
                                      context))
      (frame (list (make-event :kind :key :key :right)))
      (assert (eq (lui.example.demo::gallery-page gallery) :editing))
      (frame)
      (assert (gethash (lui:widget-id :editor context)
                (lui.frame::context-ids context)))
      (assert (not (gethash (lui:widget-id :name context)
                     (lui.frame::context-ids context))))
      (setf (lui.example.demo::gallery-page gallery) :styles)
      (frame)
      (frame (list (make-event :kind :activate :id '(:sample "Orchid"))))
      (assert (equal "Orchid" (lui.example.demo::gallery-preview gallery)))
      (frame (list (make-event :kind :activate :id :preview-action)))
      (assert (= 1 (lui.example.demo::gallery-preview-count gallery)))
      (setf (lui.example.demo::gallery-page gallery) :scroll)
      (frame)
      (let* ((list (gethash (lui:widget-id :results context)
                     (lui.frame::context-ids context)))
             (row (gethash (lui:widget-id '(:item 1) context)
                    (lui.frame::context-ids context)))
             (box (element-box row)))
        (assert (< (box-height (element-box list)) 60))
        (frame (list (make-event :kind :scroll
                                 :x (+ 1 (box-x box)) :y (box-y box)
                                 :value 6)))
        (assert (plusp (element-scroll-y
                         (gethash (lui:widget-id :results context)
                                 (lui.frame::context-ids context))))))
      (setf (lui.example.demo::gallery-page gallery) :controls)
      (frame)
      (assert (equal (lui.example.demo::gallery-name gallery) "Persistent value"))
      (assert (gethash (lui:widget-id :name context) (lui.frame::context-ids
              context)))))
  (format t "Gallery pages, toolkit consistency, tabs, and state passed.~%")
  t)
