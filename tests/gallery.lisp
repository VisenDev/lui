(defpackage #:lui.tests.gallery
  (:use #:cl #:lui #:lui.layout #:lui.frame #:lui.widgets #:lui.terminal)
  (:export #:run-tests))
(in-package #:lui.tests.gallery)

(defun run-tests ()
  (let ((context (make-terminal-context))
        (*unit* 1)
        (lui.example::*name* "Persistent value")
        (lui.example::*page* :controls)
        (lui.example::*preview* "Ocean")
        (lui.example::*preview-color* "#335d91")
        (lui.example::*preview-count* 0)
        (lui.example::*toolkit* :glass))
    (flet ((frame (&optional events)
             (with-frame (context 100 60 :events events)
               (lui.example:draw))))
      (dolist (style lui.example::*toolkits*)
        (setf lui.example::*toolkit* style)
        (dolist (page lui.example::*pages*)
          (setf lui.example::*page* (first page))
          (frame)
          (let* ((window (gethash :window (lui.frame::context-ids context)))
                 (appearance (element-content window)))
            (assert (= 1 (widget-opacity appearance)))
            (when (eq style :motif)
              (assert (equal "#b8b8b8" (widget-background appearance)))))
          (let ((tabs 0) (selected 0))
            (walk-elements
             (context-root context)
             (lambda (node)
               (let ((widget (element-content node)))
                 (when (widget-p widget)
                   ;; A whole page, including navigation, uses one collection.
                   (assert (eq style (widget-style widget)))
                   (when (eq (widget-kind widget) :tab)
                     (incf tabs)
                     (when (widget-value widget) (incf selected)))))))
            (assert (= tabs 5))
            (assert (= selected 1)))
          (assert (plusp (length (render-terminal context))))))
      (setf lui.example::*page* :controls)
      (frame)
      (setf (context-focus context) '(:page :controls))
      (frame (list (make-event :kind :key :key :right)))
      (assert (eq lui.example::*page* :editing))
      (frame)
      (assert (gethash :editor (lui.frame::context-ids context)))
      (assert (not (gethash :name (lui.frame::context-ids context))))
      (setf lui.example::*page* :styles)
      (frame)
      (frame (list (make-event :kind :activate :id '(:sample "Orchid"))))
      (assert (equal "Orchid" lui.example::*preview*))
      (frame (list (make-event :kind :activate :id :preview-action)))
      (assert (= 1 lui.example::*preview-count*))
      (setf lui.example::*page* :scroll)
      (frame)
      (let* ((list (gethash :results (lui.frame::context-ids context)))
             (row (gethash '(:item 1) (lui.frame::context-ids context)))
             (box (element-box row)))
        (assert (< (box-height (element-box list)) 60))
        (frame (list (make-event :kind :scroll
                                 :x (+ 1 (box-x box)) :y (box-y box)
                                 :value 6)))
        (assert (plusp (element-scroll-y
                        (gethash :results
                                 (lui.frame::context-ids context))))))
      (setf lui.example::*page* :controls)
      (frame)
      (assert (equal lui.example::*name* "Persistent value"))
      (assert (gethash :name (lui.frame::context-ids context)))))
  (format t "Gallery pages, toolkit consistency, tabs, and state passed.~%")
  t)
