(defpackage #:lui.tests.seven
  (:use #:cl #:lui.fn #:lui.layout #:lui.frame #:lui.terminal
        #:lui.example.seven #:lui.seven.model)
  (:export #:run-tests))
(in-package #:lui.tests.seven)

(fn input (id value)
  (make-event :kind :change :id id :value value))

(fn click (id)
  (make-event :kind :activate :id id))

(fn disabled-p ((context context) id)
  (lui.widgets:widget-disabled-p
   (element-content (gethash id (lui.frame::context-ids context)))))

(fn run-tests ()
  (let ((*state* (make-state)) (lui:*unit* 1)
        (context (make-terminal-context)))
    (labels ((frame (&optional events (time 0))
               (with-frame (context 100 60 :events events)
                 (setf (lui.frame::context-time context) time)
                 (draw)))
             (page (task)
               (setf (state-task *state*) task)
               (frame)))
      ;; Every task uses the selected collection, including controls and gauge.
      (dolist (style '(:glass :motif :garnet))
        (setf (lui.example.seven::state-toolkit *state*) style)
        (dolist (task '(:counter :temperature :flight :timer :crud))
          (page task)
          (walk-elements
           (context-root context)
           (lambda (node)
             (let ((widget (element-content node)))
               (when (lui.widgets:widget-p widget)
                 (assert (eq style (lui.widgets:widget-style widget)))))))
          (assert (plusp (length (render-terminal context))))))
      (let ((lui.example::*toolkit* :motif))
        (with-frame (context 100 60) (draw-content))
        (assert (null (gethash :seven-window
                               (lui.frame::context-ids context)))))
      (page :counter)
      (frame (list (click :seven-count)))
      (assert (= 1 (lui.example.seven::state-count *state*)))
      (frame (list (click '(:seven-task :temperature))))
      (assert (eq :temperature (state-task *state*)))
      (frame (list (input :seven-celsius "100")))
      (assert (= 212 (parse-number
                      (lui.example.seven::state-fahrenheit *state*))))
      (frame (list (input :seven-celsius "invalid")))
      (assert (equal "invalid" (lui.example.seven::state-celsius *state*)))
      (assert (= 212 (parse-number
                      (lui.example.seven::state-fahrenheit *state*))))
      (frame (list (input :seven-celsius "1e308")))
      (assert (= 212 (parse-number
                      (lui.example.seven::state-fahrenheit *state*))))
      (frame (list (input :seven-fahrenheit "32")))
      (assert (zerop (parse-number
                      (lui.example.seven::state-celsius *state*))))
      (page :flight)
      (assert (disabled-p context :seven-return))
      (frame (list (input :seven-return "invalid")))
      (assert (equal "27.03.2014"
                     (lui.example.seven::state-return *state*)))
      (frame (list (input :seven-departure "31.02.2024")))
      (assert (disabled-p context :seven-book))
      (frame (list (click :seven-book)))
      (assert (null (lui.example.seven::state-booking *state*)))
      (frame (list (input :seven-departure "02.01.2024")
                   (click :seven-return-flight)))
      (assert (not (disabled-p context :seven-return)))
      (frame (list (input :seven-return "01.01.2024")))
      (assert (disabled-p context :seven-book))
      (frame (list (input :seven-return "03.01.2024")))
      (assert (not (disabled-p context :seven-book)))
      (frame (list (click :seven-book)))
      (assert (search "02.01.2024 to 03.01.2024"
                      (lui.example.seven::state-booking *state*)))
      (frame (list (click :seven-one-way)))
      (assert (disabled-p context :seven-return))
      (frame (list (input :seven-return "invalid")
                   (click :seven-book)))
      (assert (search "one-way" (lui.example.seven::state-booking *state*)))
      ;; Supplied frame times make duration, pause/resume and reset deterministic.
      (setf (state-task *state*) :timer
            (lui.example.seven::state-timer *state*) (make-timer :duration 2))
      (frame nil 100)
      (let* ((timer (lui.example.seven::state-timer *state*))
             (gauge (gethash :seven-elapsed
                             (lui.frame::context-ids context))))
        (assert (not (element-interactive-p gauge)))
        (frame nil 101)
        (assert (= 1 (timer-elapsed timer)))
        (assert (<= 101 (context-next-frame context) (+ 101 (/ 1 60))))
        (frame (list (input :seven-duration 0.5)) 101)
        (assert (= 1 (timer-elapsed timer)))
        (assert (null (context-next-frame context)))
        (frame nil 200)
        (assert (= 1 (timer-elapsed timer)))
        (frame (list (input :seven-duration 5)) 200)
        (assert (= 1 (timer-elapsed timer)))
        (frame nil 201)
        (assert (= 2 (timer-elapsed timer)))
        (frame (list (click :seven-reset)) 201)
        (assert (zerop (timer-elapsed timer))))
      (page :crud)
      (let* ((model (lui.example.seven::state-crud *state*))
             (person (first (crud-records model)))
             (id (person-id person)))
        (assert (disabled-p context :seven-update))
        (assert (disabled-p context :seven-delete))
        (frame (list (click (list :seven-person id))))
        (assert (equal "Hans" (lui.example.seven::state-name *state*)))
        (assert (not (disabled-p context :seven-update)))
        (frame (list (input :seven-name "Anna")
                     (input :seven-surname "Smith")
                     (click :seven-update)))
        (assert (equal "Anna" (person-name person)))
        (assert (equal "Smith" (person-surname person)))
        (frame (list (input :seven-filter "Sm")))
        (assert (= 1 (length (crud-filter model "Sm"))))
        (assert (gethash (list :seven-person id)
                         (lui.frame::context-ids context)))
        (frame (list (click :seven-delete)))
        (assert (null (crud-selected model)))
        (assert (= 2 (length (crud-records model))))
        (frame (list (input :seven-name "Ada")
                     (input :seven-surname "Stone")
                     (click :seven-create)))
        (assert (= 3 (length (crud-records model))))
        (assert (equal "Stone" (person-surname (car (last
                                                     (crud-records model))))))
        (frame (list (input :seven-filter "Em")))
        (assert (null (crud-filter model "Em"))))))
  (test-record-selection)
  (format t "Seven GUIs counter, conversion, flight, timer, and CRUD passed.~%")
  t)

(fn test-record-selection ()
  (dolist (style '(:glass :motif :garnet))
    (let ((*state* (make-state :task :crud :toolkit style))
          (lui:*unit* 1) (context (make-terminal-context)))
      (labels ((frame (&rest events)
                 (with-frame (context 100 60 :events events) (draw)))
               (row-id (person) (list :seven-person (person-id person)))
               (selected (person)
                 (let ((widget (element-content
                                (gethash (row-id person)
                                         (lui.frame::context-ids context)))))
                   (assert (eq :list-item (lui.widgets:widget-kind widget)))
                   (lui.widgets:widget-value widget))))
        (frame)
        (let* ((model (lui.example.seven::state-crud *state*))
               (first (first (crud-records model)))
               (second (second (crud-records model)))
               (last (third (crud-records model))))
          (frame (click (row-id first)))
          (assert (selected first))
          (assert (not (selected second)))
          (assert (equal (row-id first) (context-focus context)))
          (frame (input :seven-name "Draft name"))
          (frame (click (row-id first)))
          (assert (equal "Draft name" (lui.example.seven::state-name *state*)))
          (frame (make-event :kind :key :key :down))
          (assert (selected second))
          (assert (not (selected first)))
          (assert (equal "Max" (lui.example.seven::state-name *state*)))
          (assert (equal (row-id second) (context-focus context)))
          (frame (make-event :kind :key :key :end))
          (assert (selected last))
          (frame (make-event :kind :key :key :down))
          (assert (selected last))
          (frame (make-event :kind :key :key :home))
          (assert (selected first))
          (frame (make-event :kind :key :key :up))
          (assert (selected first))
          (setf (context-focus context) :seven-name)
          (frame (input :seven-name "Unsaved"))
          (assert (equal :seven-name (context-focus context)))
          (assert (selected first))
          ;; Deletion selects its next neighbor and paints that state now.
          (frame (click :seven-delete))
          (assert (selected second))
          (assert (equal :seven-name (context-focus context)))
          (frame (input :seven-filter "T"))
          (assert (null (crud-selected model)))
          (assert (disabled-p context :seven-update))
          (frame (click (row-id last)))
          (assert (selected last))
          (frame (input :seven-surname "Taylor") (click :seven-update))
          (assert (selected last))
          (let ((widget (element-content
                         (gethash (row-id last)
                                  (lui.frame::context-ids context)))))
            (assert (equal "Taylor, Roman" (lui.widgets:widget-text widget))))
          (frame (click :seven-delete))
          (assert (null (crud-selected model)))
          (assert (equal "" (lui.example.seven::state-name *state*)))))))
  t)
