(defpackage #:lui.tests.seven.cells
  (:use #:cl #:lui.fn #:lui.layout #:lui.frame #:lui.tests.support
        #:lui.example.seven.cells #:lui.seven.model)
  (:export #:run-tests))
(in-package #:lui.tests.seven.cells)

(fn cell-id ((index integer)) (list :seven-cell index))

(fn run-tests ()
  (dolist (style '(:glass :motif :garnet))
    (let ((state (make-state)) (lui:*unit* 1)
          (context (make-test-context)))
      (labels ((frame (&rest events)
                 (with-frame (context 100 60 :events events)
                   (lui:with-toolkit (style) (draw-content state))))
               (key (name) (make-event :kind :key :key name))
               (change (text)
                 (make-event :kind :change
                             :id (cell-id (state-selected state))
                             :value text))
               (activate () (make-event :kind :activate))
               (widget-at (index)
                 (element-content
                   (gethash (lui:widget-id (cell-id index) context)
                     (lui.frame::context-ids context))))
               (edit (index)
                 (setf (context-focus context) (lui:widget-id (cell-id index)
                                                 context))
                 (frame (activate))
                 (assert (eql index (state-editing state))))
               (value-is (address number)
                 (let ((cell (sheet-cell (state-sheet state) address)))
                   (assert (= number (cell-value cell))))))
        (frame)
        (assert (null (gethash (lui:widget-id (cell-id 0) context)
                               (lui.frame::context-ids context))))
        (assert (context-next-frame context))
        (frame)
        (assert (not (element-reserve-space-p
                  (gethash (lui:widget-id (cell-id 0) context)
                    (lui.frame::context-ids context)))))
        (assert (eq :cell (lui.widgets:widget-kind (widget-at 0))))
        (assert (lui.widgets:widget-value (widget-at 0)))
        (assert (not (lui.widgets:widget-value (widget-at 1))))
        (assert (equal "#ffffff"
                       (lui.widgets:widget-background (widget-at 1))))
        (assert (equal "#202430"
                       (lui.widgets:widget-foreground (widget-at 1))))
        (let ((headers 0))
          (walk-elements
           (context-root context)
           (lambda (node)
             (let ((widget (element-content node)))
               (when (and (lui.widgets:widget-p widget)
                          (eq :cell (lui.widgets:widget-kind widget))
                          (lui.widgets:widget-disabled-p widget)
                          (equal "#e5e9ee"
                                 (lui.widgets:widget-background widget)))
                 (incf headers)
                 (assert (not (element-interactive-p node)))
                 (assert (equal "#202430"
                                (lui.widgets:widget-foreground widget)))))))
          (assert (> headers 3)))
        (let ((count 0))
          (maphash (lambda (id node)
                     (declare (ignore node))
                     (setf id (lui:widget-key id))
                     (when (and (consp id) (eq :seven-cell (first id)))
                       (incf count)))
                   (lui.frame::context-ids context))
          (assert (< 1 count 300))
          (assert (null (gethash (lui:widget-id (cell-id 2599) context)
                                 (lui.frame::context-ids context)))))
        (let ((sheet (state-sheet state)))
          (sheet-set sheet "A0" "2")
          (sheet-set sheet "B0" "3")
          (sheet-set sheet "C0" "=sum(A0:B0)"))
        (frame)
        (assert (= 5 (parse-number
                       (lui.widgets:widget-text (widget-at 2)))))
        ;; Control bytes cannot start an edit or become document contents.
        (frame (make-event :kind :text :id (cell-id 0)
                           :value (string (code-char 1))))
        (assert (null (state-editing state)))
        (edit 0)
        (assert (eq :text-field (lui.widgets:widget-kind (widget-at 0))))
        (assert (equal "#ffffff"
                       (lui.widgets:widget-background (widget-at 0))))
        (assert (equal "#000000"
                       (lui.widgets:widget-foreground (widget-at 0))))
        (assert (equal "2" (lui.widgets:widget-value (widget-at 0))))
        (frame (make-event :kind :text :value (string (code-char 1)))
               (make-event :kind :text :value "X"))
        (assert (equal "X2" (lui.widgets:widget-value (widget-at 0))))
        (dotimes (i 3)
          (frame)
          (assert (eql 0 (state-editing state)))
          (assert (eq :text-field (lui.widgets:widget-kind (widget-at 0))))
          (assert (equal "#ffffff"
                         (lui.widgets:widget-background (widget-at 0)))))
        (frame (make-event :kind :text :value (string (code-char 5)))
               (make-event :kind :text :value (string (code-char 8))))
        (assert (equal "X" (lui.widgets:widget-value (widget-at 0))))
        (frame (key :escape))
        (edit 0)
        ;; Batched final text and Enter must commit the latest draft exactly once.
        (frame (change "10") (activate))
        (assert (null (state-editing state)))
        (value-is "A0" 10)
        (value-is "C0" 13)
        (assert (= 13 (parse-number
                       (lui.widgets:widget-text (widget-at 2)))))
        (edit 2)
        (assert (equal "=sum(A0:B0)"
                       (lui.widgets:widget-value (widget-at 2))))
        (frame (change "discard this") (key :escape))
        (assert (null (state-editing state)))
        (value-is "C0" 13)
        (assert (equal "=sum(A0:B0)"
                       (cell-text (sheet-cell (state-sheet state) 2))))
        (edit 1)
        (setf (context-focus context) (lui:widget-id :seven-grid-horizontal
                                        context))
        (frame (change "4"))
        (assert (null (state-editing state)))
        (value-is "C0" 14)
        ;; A real pointer double-click enters raw formula editing.
        (let ((box (gethash (lui:widget-id (cell-id 2) context)
                            (lui.frame::context-regions context))))
          (frame (make-event :kind :press :clicks 2
                             :x (+ (box-x box) 1) :y (+ (box-y box) 1))))
        (assert (eql 2 (state-editing state)))
        (frame (change "=div(1,0)") (activate))
        (assert (equal "#DIV/0!" (lui.widgets:widget-text (widget-at 2))))
        (frame (key :right))
        (assert (= 3 (state-selected state)))
        (frame (key :down))
        (assert (= 29 (state-selected state)))
        (frame (key :left))
        (assert (= 28 (state-selected state)))
        (frame (key :up))
        (assert (= 2 (state-selected state)))
        ;; End reaches the far corner without constructing the full grid.
        (frame (key :end))
        (assert (= 2599 (state-selected state)))
        (assert (equal (cell-id 2599) (lui:widget-key (context-focus
                  context))))
        (let* ((grid (gethash (lui:widget-id :seven-grid context)
                       (lui.frame::context-ids context)))
               (cell (gethash (lui:widget-id (cell-id 2599) context)
                              (lui.frame::context-ids context)))
               (clip (element-clip cell)))
          (assert (plusp (element-scroll-x grid)))
          (assert (plusp (element-scroll-y grid)))
          (assert (plusp (box-width clip)))
          (assert (plusp (box-height clip))))
        (frame (activate))
        (frame (change "=sum(A0:B0)") (activate))
        (value-is "Z99" 14)
        (frame (key :home))
        (assert (= 0 (state-selected state)))
        (let ((grid (gethash (lui:widget-id :seven-grid context)
                      (lui.frame::context-ids context))))
          (assert (zerop (element-scroll-x grid)))
          (assert (zerop (element-scroll-y grid))))
        ;; Typing begins a fresh draft and must apply its event only once.
        (frame (make-event :kind :text :value "7"))
        (assert (equal "7" (lui.widgets:widget-value (widget-at 0))))
        (frame (activate))
        (value-is "A0" 7)
        (value-is "Z99" 11)
        ;; Scrolling cannot make cell hit regions overlap sticky headers.
        (with-frame (context 100 60)
          (scroll-to :seven-grid 15 4)
          (lui:with-toolkit (style) (draw-content state)))
        (let* ((grid (gethash (lui:widget-id :seven-grid context)
                       (lui.frame::context-ids context)))
               (bounds (element-box grid)))
          (walk-elements
           grid
           (lambda (node)
              (let ((id (lui:widget-key (element-id node))) (clip
                      (element-clip node)))
               (when (and (consp id) (eq :seven-cell (first id))
                          (plusp (box-width clip)) (plusp (box-height clip)))
                 (assert (>= (box-x clip) (+ (box-x bounds) 4)))
                 (assert (>= (box-y clip) (+ (box-y bounds) 3))))))))
        ;; Reentry reuses a matching viewport without a full-window guess.
        (with-frame (context 100 60))
        (frame)
        (assert (gethash (lui:widget-id (cell-id 27) context)
                  (lui.frame::context-ids context)))
        ;; A different toolkit invalidates the cached viewport key.
        (with-frame (context 100 60))
        (lui:with-toolkit ((if (eq style :glass) :motif :glass))
          (with-frame (context 100 60) (draw-content state))
          (assert (null (gethash (lui:widget-id (cell-id 27) context)
                                 (lui.frame::context-ids context)))))
        (frame)
        ;; Resize schedules a second measurement with the new viewport geometry.
        (with-frame (context 120 70)
          (lui:with-toolkit (style) (draw-content state)))
        (assert (context-next-frame context))
        (with-frame (context 120 70)
          (lui:with-toolkit (style) (draw-content state)))
        (assert (plusp (visible-widget-count context))))))
  (format t "Cells virtual grid, formulas, editing, navigation and clips passed.~%")
  t)
