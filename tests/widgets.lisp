(defpackage #:%lui.tests.widgets
  (:use #:cl #:%lui.layout #:%lui.frame #:%lui.tests.support)
  (:export #:run-tests))

(in-package #:%lui.tests.widgets)

(defun test-password ()
  (let ((context (make-test-context)) (value "a界b"))
    (with-frame (context 30 5)
      (%lui.tests.support::draw-text-field (lui:opt :id :password :value value
                                            :password-p t)))
    (with-frame (context 30 5 :events
                         (list (make-event :kind :text :id :password
                                           :value "!")))
      (multiple-value-bind (updated changed)
        (%lui.tests.support::draw-text-field (lui:opt :id :password :value
                                              value :password-p t))
        (assert changed)
        (setf value updated)))
    (assert (string= value "a界b!"))
    (let ((widget (element-content
                    (gethash (lui:widget-id :password context)
                      (%lui.frame::context-ids context)))))
      (assert (%lui.widgets:widget-password-p widget))
      (assert (string= "****" (%lui.widgets:widget-display-value widget)))
      (assert (string= "[****]"
                       (%lui.widgets:widget-terminal-text widget))))))

(defun test-readline ()
  (let ((context (make-test-context))
        (text "alpha beta gamma"))
    (labels ((draw () (setf text (lui:with-toolkit (:glass)
                                   (%lui.tests.support::draw-text-field
                                     (lui:opt :id :edit :value text)))))
             (key (&rest keys)
               (with-frame
                   (context 60 5 :events
                            (mapcar (lambda (key)
                                      (make-event :kind :key :id :edit
                                                  :key key))
                                    keys))
                 (draw)))
             (insert (value)
               (with-frame
                   (context 60 5 :events
                            (list (make-event :kind :text :id :edit
                                              :value value)))
                 (draw))))
      (with-frame (context 60 5) (draw))
      (setf (context-focus context) (lui:widget-id :edit context))
      (assert (%lui.widgets:text-field-focused-p context))
      (key :home :right :delete :end :left :backspace)
      (assert (string= text "apha beta gama"))
      (key :home :kill-end :yank)
      (assert (string= text "apha beta gama"))
      (key :kill-word :kill-word)
      (assert (string= text "apha "))
      (key :yank)
      (assert (string= text "apha beta gama"))
      (key :home :word-right :word-right :kill-start)
      (assert (string= text " gama"))
      (key :yank :end :transpose)
      (assert (string= text "apha beta gaam"))
      (key :home :kill-word-forward)
      (assert (string= text " beta gaam"))
      (key :yank :home :word-right :shift-word-right)
      (insert "|")
      (assert (string= text "apha| gaam"))
      (key :select-all)
      (insert (format nil "one~%two three"))
      (key :home :kill-end)
      (assert (string= text (format nil "one~%")))
      (key :yank :up :home :kill-end :kill-end)
      (assert (string= text "two three"))
      (key :yank)
      (assert (string= text (format nil "one~%two three")))
      (key :select-all)
      (insert "Raven River")
      (key :kill-word)
      (assert (string= text "Raven "))))
  (assert (eq :home (%lui.widgets:readline-key "a" :control t)))
  (assert (eq :select-all
              (%lui.widgets:readline-key "A" :control t :shift t)))
  (assert (eq :word-left
              (%lui.widgets:readline-key "ArrowLeft" :control t)))
  (assert (eq :word-right (%lui.widgets:readline-key "f" :alt t)))
  ;; Selection replacement, empty-input boundaries, and shrink clamping.
  (let ((state (%lui.widgets:make-edit-state :cursor 50 :anchor 50)))
    (assert (string= "" (%lui.widgets:edit-text
                         "" state
                         (mapcar (lambda (key)
                                   (make-event :kind :key :key key))
                                 '(:left :backspace :delete
                                   :transpose :yank)))))
    (assert (zerop (%lui.widgets:edit-state-cursor state)))))

(defun test-searchable-combobox ()
  (let ((context (make-test-context)) (value nil) changed disabled (top 0))
    (labels ((frame (&rest events)
               (with-frame (context 40 12 :events events)
                 (column (lui:opt :height (fixed top)))
                 ;; The suggestions must escape the clipped, one-line container.
                 (column (lui:opt :width (fixed 24) :height (fixed 1) :clip-p
                   t)
                   (multiple-value-bind (new-value changed-p)
                     (%lui.tests.support::draw-searchable-combobox
                      #("Alpha" "Beta" "Gamma" "Gamma")
                      (lui:opt :id :combo :value value :width (grow)
                               :max-results 3 :disabled-p disabled))
                     (setf value new-value
                           changed changed-p)))
                 (%lui.tests.support::draw-button "Next" (lui:opt :id :next))))
             (node (id) (gethash (lui:widget-id id context)
                          (%lui.frame::context-ids context)))
             (bounds (id) (element-box (node id)))
             (key (key) (make-event :kind :key :key key)))
      (frame)
      (assert (eq :text-field (%lui.widgets:widget-kind (element-content (node
                  :combo)))))
      (let ((next-y (box-y (bounds :next))))
        (frame (make-event :kind :tab))
        (assert (equal (lui:widget-key (context-focus context)) :combo))
        (assert (= next-y (box-y (bounds :next)) (box-y (bounds '(:combo
                    :popup)))))
        (frame (make-event :kind :text :value "gAM"))
        (assert (and changed (equal value "gAM")))
        (assert (and (node '(:combo :choice 3)) (null (node '(:combo :choice
                    0)))))
        ;; Enter with no explicit highlight preserves the custom spelling.
        (frame (make-event :kind :activate))
        (assert (and (equal value "gAM") (null (node '(:combo :popup)))))
        (frame (key :down) (make-event :kind :activate))
        (assert (and changed (equal value "Gamma")))
        (frame (key :select-all) (make-event :kind :text :value "Unlisted"))
        (assert (and changed (equal value "Unlisted") (null (node '(:combo
                    :popup)))))
        (frame (key :escape))
        (assert (equal value "Unlisted"))
        (frame (key :select-all) (key :backspace))
        (assert (and changed (equal value "")))
        (let* ((box (bounds '(:combo :choice 1)))
               (x (+ (box-x box) 0.5)) (y (+ (box-y box) 0.5)))
          (frame (make-event :kind :press :x x :y y)
                 (make-event :kind :release :x x :y y)))
        (assert (and changed (equal value "Beta") (null (node '(:combo
                    :popup)))))
        (assert (= next-y (box-y (bounds :next)))))
      (setf top 10)
      (frame (key :down))
      (let ((popup (bounds '(:combo :popup))))
        (assert (= (+ (box-y popup) (box-height popup)) (box-y (bounds
                  :combo)))))
      (frame (make-event :kind :press :x 36 :y 0))
      (assert (null (node '(:combo :popup))))
      (frame (key :down))
      (frame (make-event :kind :tab))
      (assert (and (eq :next (lui:widget-key (context-focus context))) (null
              (node '(:combo :popup)))))
      (setf disabled t)
      (frame (make-event :kind :text :id :combo :value "ignored"))
      (assert (and (not changed) (equal value "Beta"))))))

(defun test-tabs-and-hover ()
  (let ((context (make-test-context))
        (selected :one))
    (labels ((draw ()
               (row (lui:opt)
                 (when (lui:with-toolkit (:glass)
                         (%lui.tests.support::draw-tab "One" (lui:opt :id :one
                    :selected-p (eq selected :one))))
                   (setf selected :one))
                 (lui:with-toolkit (:glass)
                   (%lui.tests.support::draw-tab
                    "Disabled" (lui:opt :id :disabled :disabled-p t)))
                 (when (lui:with-toolkit (:glass)
                         (%lui.tests.support::draw-tab "Two" (lui:opt :id :two
                    :selected-p (eq selected :two))))
                   (setf selected :two))))
             (key (id &rest keys)
               (with-frame
                   (context 40 4 :events
                            (mapcar (lambda (key)
                                      (make-event :kind :key :id id :key key))
                                    keys))
                 (draw))))
      (with-frame (context 40 4) (draw))
      (setf (context-focus context) (lui:widget-id :one context))
      (key :one :right)
      (assert (eq selected :two))
      (assert (eq (lui:widget-key (context-focus context)) :two))
      (assert (context-focus-visible-p context))
      (key :two :right)
      (assert (eq selected :one))
      (key :one :end)
      (assert (eq selected :two))
      (key :two :home)
      (assert (eq selected :one))
      (key :one :right :right)
      (assert (eq selected :one))
      (with-frame
          (context 40 4 :events (list (make-event :kind :move :x 1 :y 0)))
        (draw)
        (assert (hovered-p :one)))
      (assert (eq :one (lui:widget-key (context-hover context))))
      (with-frame (context 40 4))
      (assert (null (lui:widget-key (context-hover context))))
      (with-frame (context 40 4) (draw))
      (setf (context-focus context) (lui:widget-id :two context)
            (context-focus-visible-p context) t)
      (with-frame
          (context 40 4 :events (list (make-event :kind :press :x 1 :y 0)))
        (draw))
      (assert (eq :one (lui:widget-key (context-hover context))))
      (assert (eq :two (lui:widget-key (context-focus context))))
      (assert (not (context-focus-visible-p context)))
      (with-frame (context 41 4) (draw))
      (assert (null (lui:widget-key (context-hover context)))))))

(defun test-keyboard-activation ()
  (let ((context (make-test-context))
        (buttons 0) (tabs 0) (checked nil) (text "x"))
    (labels ((draw ()
               (when (lui:with-toolkit (:glass)
                       (%lui.tests.support::draw-button "Button" (lui:opt :id
                  :button))) (incf buttons))
               (setf checked (lui:with-toolkit (:glass)
                               (%lui.tests.support::draw-checkbox "Check"
                                 (lui:opt :id :check :value checked))))
               (when (lui:with-toolkit (:glass)
                       (%lui.tests.support::draw-tab
                        "Tab" (lui:opt :id :tab :selected-p t)))
                 (incf tabs))
               (setf text (lui:with-toolkit (:glass)
                            (%lui.tests.support::draw-text-field (lui:opt :id
                  :text :value text))))
               (lui:with-toolkit (:glass)
                 (%lui.tests.support::draw-button
                  "Disabled" (lui:opt :id :disabled :disabled-p t))))
             (frame (&rest events)
               (with-frame (context 40 10 :events events) (draw))))
      (frame)
      (assert (eq :pointer (%lui.widgets:cursor-at context 1 0)))
      (assert (eq :text (%lui.widgets:cursor-at context 1 3)))
      (assert (eq :not-allowed (%lui.widgets:cursor-at context 1 4)))
      (frame (make-event :kind :tab :key :backward))
      (assert (eq :text (lui:widget-key (context-focus context))))
      (frame (make-event :kind :tab))
      (assert (eq :button (lui:widget-key (context-focus context))))
      (frame (make-event :kind :tab :key :backward))
      (assert (eq :text (lui:widget-key (context-focus context))))
      (frame (make-event :kind :tab :key :backward))
      (assert (eq :tab (lui:widget-key (context-focus context))))
      (dolist (id '(:button :check :tab))
        (setf (context-focus context) (lui:widget-id id context))
        (assert (%lui.widgets:activation-focused-p context))
        (dolist (key '(:enter :space))
          (frame (make-event :kind :activate :key key))))
      (assert (= buttons 2))
      (assert (= tabs 2))
      (assert (null checked))
      (setf (context-focus context) (lui:widget-id :text context))
      (assert (not (%lui.widgets:activation-focused-p context)))
      (frame (make-event :kind :text :value " "))
      (assert (string= text "x ")))))

(defun test-radio-group ()
  (let ((context (make-test-context)) (value :first))
    (labels ((draw ()
               (setf value (%lui.tests.support::draw-radio :first "First"
                             (lui:opt :id :first-radio :value value))
                 value (%lui.tests.support::draw-radio :second "Second"
                         (lui:opt :id :second-radio :value value)))))
      (with-frame (context 40 4) (draw))
      (assert (eq :first value))
      (setf (%lui.frame:context-focus context) (lui:widget-id :first-radio
                                                context))
      (assert (%lui.widgets:activation-focused-p context))
      (with-frame (context 40 4 :events
                           (list (make-event :kind :activate
                                             :id :second-radio)))
        (draw))
      (assert (eq :second value))
      (with-frame (context 40 4 :events
                           (list (make-event :kind :activate
                                             :id :first-radio)))
        (draw))
      (assert (eq :first value)))))

(defun test-nested-scroll ()
  (let ((context (make-test-context)))
    (labels ((draw (bounded)
               (column (lui:opt :id :outer :width (fixed 12) :height (fixed 3)
                        :scroll-p t)
                 (column (lui:opt :id :inner :width (grow) :scroll-p t
                          :height (if bounded (fixed 2) (fit)))
                   (dotimes (i 5)
                     (lui:with-toolkit (:glass)
                       (%lui.tests.support::draw-button (format nil "Row ~D" i)
                         (lui:opt :id (list :row i) :width (grow) :height
                           (fixed 1))))))
                 (lui.glass:label "after" (lui:opt :height (fixed 4)))))
             (frame (bounded &rest events)
               (with-frame (context 12 8 :events events) (draw bounded)))
             (offset (id)
               (let ((offset nil))
                 (walk-elements
                  (context-root context)
                  (lambda (node)
                     (when (eq id (lui:widget-key (element-id node)))
                      (setf offset (element-scroll-y node)))))
                 offset)))
      (frame nil)
      (frame nil (make-event :kind :move :x 1 :y 0)
                 (make-event :kind :scroll :x 1 :y 0 :value 1))
      ;; The hovered row is inside a zero-range inner scroller. Its parent moves.
      (assert (equal '(:row 0) (lui:widget-key (context-hover context))))
      (assert (= 0 (offset :inner)))
      (assert (= 1 (offset :outer)))
      (frame nil (make-event :kind :scroll :x 1 :y 0 :value -20))
      (assert (= 0 (offset :outer)))
      (frame t)
      (frame t (make-event :kind :scroll :x 1 :y 0 :value 2)
               (make-event :kind :scroll :x 1 :y 0 :value 3))
      ;; Exhaust the inner viewport, then pass the unused delta to its parent.
      (assert (= 3 (offset :inner)))
      (assert (= 2 (offset :outer))))))

(defun test-scrollbar ()
  (let ((context (make-test-context)) (visible t) (wide nil))
    (labels ((draw ()
               (lui:panel (lui:opt :id :viewport :width (fixed 20)
                                   :height (fixed 10) :padding 1 :scroll-p t
                                   :scrollbar-p visible :scrollbar-width 2)
                 (dotimes (index 12)
                   (%lui.tests.support::draw-button "Row" (lui:opt
                  :id (list :row index) :width (if wide (fixed 30) (grow))
                                        :height (fixed 3))))))
             (frame (&rest events)
               (with-frame (context 30 15 :events events) (draw)))
             (bar ()
               (gethash (lui:widget-id '(:lui.scrollbar :viewport) context)
                        (%lui.frame::context-ids context)))
             (row ()
               (gethash (lui:widget-id '(:row 0) context)
                 (%lui.frame::context-ids context))))
      (frame)
      (let* ((node (bar)) (track (element-box node))
             (thumb (%lui.widgets:scrollbar-thumb node)))
        (assert (= 17 (box-x track)))
        (assert (= 8 (box-height track)))
        (assert (= 4 (box-height thumb)))
        (assert (= 16 (box-width (element-box (row)))))
        (frame (make-event :kind :press :x 18 :y 2)
               (make-event :kind :move :x 50 :y 100)
               (make-event :kind :release :x 50 :y 100))
        (let ((*context* context))
          (assert (= 28 (nth-value 1 (scroll-position :viewport))))))
      (frame (make-event :kind :key :id '(:lui.scrollbar :viewport)
                         :key :home))
      (let ((*context* context))
        (assert (zerop (nth-value 1 (scroll-position :viewport))))
        (scroll-to :viewport 0 7))
      (frame)
      (let ((*context* context))
        (assert (= 7 (nth-value 1 (scroll-position :viewport)))))
      (frame (make-event :kind :press :x 18 :y 8)
             (make-event :kind :release :x 18 :y 8))
      (let ((*context* context))
        (assert (= 15 (nth-value 1 (scroll-position :viewport)))))
      (setf visible nil)
      (frame)
      (assert (null (bar)))
      (assert (= 18 (box-width (element-box (row)))))
      (setf visible t wide t)
      (frame)
      (let ((*context* context)) (scroll-to :viewport 5 7))
      (frame)
      (frame (make-event :kind :key :id '(:lui.scrollbar :viewport)
                         :key :home))
      (let ((*context* context))
        (assert (= 5 (scroll-position :viewport)))
        (assert (zerop (nth-value 1 (scroll-position :viewport))))))))

(defun test-retained-editor-state ()
  (let ((context (make-test-context)))
    (flet ((draw (step)
             (loop :for i :from 0 :below 32 :by step
                   :do (%lui.tests.support::draw-text-field (lui:opt :id (list
                    :edit i) :value "Text")))))
      (with-frame (context 80 40) (draw 1))
      (let ((retained (gethash (lui:widget-id (list :edit 4) context)
                        (context-state context))))
        (setf (context-focus context) (lui:widget-id (list :edit 4) context))
        (assert (%lui.widgets:text-field-focused-p context))
        (with-frame (context 80 40) (draw 2))
        (assert (= 16 (hash-table-count (context-state context))))
        (dotimes (i 32)
          (assert (eql (evenp i)
                       (nth-value 1
                      (gethash (lui:widget-id (list :edit i)
                                 context) (context-state context))))))
        (assert (eq retained (gethash (lui:widget-id (list :edit 4) context)
                                     (context-state context))))
        (assert (%lui.widgets:text-field-focused-p context))
        (with-frame (context 80 40) (lui:label "No editor"))
        (assert (zerop (hash-table-count (context-state context))))
        (assert (null (lui:widget-key (context-focus context))))
        (assert (not (%lui.widgets:text-field-focused-p context)))))))

(defun test-container-options ()
  "Check option expressions, single evaluation, and container directions."
  (let ((context (make-test-context))
        (options (lui:opt :id :column :gap 3))
        (calls 0))
    (with-frame (context 30 10)
      (lui:row (progn (incf calls) (lui:opt :id :row :gap 2))
        (lui:column options)))
    (assert (= calls 1))
    (let* ((row (gethash :row (context-ids context)))
           (column (gethash :column (context-ids context))))
      (assert (eq :row (element-direction row)))
      (assert (eq :column (element-direction column)))
      (assert (= 2 (element-gap row)))
      (assert (= 3 (element-gap column)))
      (assert (eq column (aref (element-children row) 0))))))

(defun test-spacing-controls ()
  (let ((context (make-test-context)) (left nil) (space nil) (right nil))
    (with-frame (context 30 10)
      (lui:row (lui:opt :width (grow) :height (grow))
        (setf left (lui:spacer (lui:opt :width (fixed 3))))
        (setf space (lui:spacer (lui:opt :width (grow))))
        (setf right (lui:spacer (lui:opt :width (fixed 5))))))
    (assert (= 3 (box-width (element-box left))))
    (assert (= 22 (box-width (element-box space))))
    (assert (= 25 (box-x (element-box right))))
    (assert (null (element-content space)))
    (assert (not (element-interactive-p space)))
    (with-frame (context 30 10)
      (lui:hr (lui:opt :id :horizontal))
      (setf space (lui:spacer (lui:opt :height (grow))))
      (lui:row (lui:opt :width (grow) :height (fixed 3))
        (lui:vr (lui:opt :id :vertical))
        (setf right (lui:spacer (lui:opt :padding 1)))))
    (let ((horizontal (gethash (lui:widget-id :horizontal context)
                               (context-ids context)))
          (vertical (gethash (lui:widget-id :vertical context)
                             (context-ids context))))
      (assert (= 30 (box-width (element-box horizontal))))
      (assert (= 1 (box-height (element-box horizontal))))
      (assert (= 1 (box-width (element-box vertical))))
      (assert (= 3 (box-height (element-box vertical))))
      (assert (= 6 (box-height (element-box space))))
      (assert (= 2 (box-width (element-box right))))
      (assert (= 2 (box-height (element-box right))))
      (assert (not (element-interactive-p horizontal)))
      (assert (not (element-interactive-p vertical))))))

(defun test-spinner ()
  (let ((context (make-test-context))
        (sample 0))
    (flet ((draw (visible disabled)
             (with-frame (context 20 10)
               (setf sample (lui:frame-time))
               (when visible
                 (lui:spinner (lui:opt :id :loading
                                       :disabled-p disabled))))))
      (draw t nil)
      (let* ((id (lui:widget-id :loading context))
             (node (gethash id (context-ids context)))
             (widget (element-content node)))
        (assert (= 1 (box-width (element-box node))))
        (assert (= 1 (box-height (element-box node))))
        (assert (not (element-interactive-p node)))
        (assert (<= 0 (%lui.widgets:widget-value widget) 7))
        (assert (= 1 (length (%lui.widgets:widget-terminal-text widget))))
        (assert (< sample (context-next-frame context) (+ sample 0.11))))

      ;; Pausing or removing the spinner must stop animation deadlines.
      (draw t t)
      (assert (null (context-next-frame context)))
      (draw nil nil)
      (assert (null (context-next-frame context))))))

(defun test-floating-menus ()
  (let ((context (make-test-context))
        (ids (make-hash-table))
        (actions 0)
        (disabled nil))
    (labels ((remember (key id) (setf (gethash key ids) id))
             (draw ()
               (lui:menu-bar (lui:opt :id :test-menu-bar)
                 (remember :file
                   (nth-value 2
                     (lui:menu "File" (lui:opt :open-on-hover-p nil)
                       (remember :first
                         (nth-value 2 (lui:menu-item "First")))
                       (lui:menu-item "Disabled" (lui:opt :disabled-p t))
                       (remember :sub
                         (nth-value 2
                           (lui:menu "Sub" nil
                             (multiple-value-bind (activated changed id)
                                 (lui:menu-item "Action")
                               (declare (ignore changed))
                               (remember :action id)
                               (when activated (incf actions)))
                             (lui:menu-item "After action")))))))
                 (remember :edit
                   (nth-value 2
                     (lui:menu "Edit" (lui:opt :disabled-p disabled)
                       (lui:menu-item "Copy")))))
               (remember :after (nth-value 2 (lui:button "After"))))
             (frame (&rest events)
               (with-frame (context 60 20 :events events) (draw)))
             (key (key) (frame (make-event :kind :key :key key)))
             (depth () (length (context-floating-path context))))
      (frame)
      (assert (= 0 (depth)))
      ;; Flush triggers must not obscure part of a panel bevel behind the bar.
      (assert (null (element-content
                     (gethash (lui:widget-id :test-menu-bar context)
                              (context-ids context)))))

      ;; Keyboard opening focuses the first enabled row and skips disabled rows.
      (setf (context-focus context) (gethash :file ids))
      (key :down)
      (assert (= 1 (depth)))
      (assert (equal (context-focus context) (gethash :first ids)))
      (key :down)
      (assert (equal (context-focus context) (gethash :sub ids)))
      (key :right)
      (assert (= 2 (depth)))

      ;; Escape restores each parent trigger, then closes the root menu.
      (key :escape)
      (assert (= 1 (depth)))
      (assert (equal (context-focus context) (gethash :sub ids)))
      (key :escape)
      (assert (= 0 (depth)))
      (assert (equal (context-focus context) (gethash :file ids)))

      ;; A disabled sibling must not dismiss the currently open menu.
      (setf disabled t)
      (key :down)
      (assert (= 1 (depth)))
      (frame (make-event :kind :press :x 59 :y 19))
      (assert (= 0 (depth)))
      (assert (= 0 actions))

      ;; Activating a nested action closes the whole chain exactly once.
      (setf (context-focus context) (gethash :file ids))
      (key :down)
      (key :end)
      (key :right)
      (assert (equal (context-focus context) (gethash :action ids)))
      (frame (make-event :kind :activate :id (gethash :action ids)))
      (assert (= 1 actions))
      (assert (= 0 (depth)))
      ;; Remaining body forms must not leave identities for detached children.
      (let ((visible-ids (make-hash-table :test 'equal)))
        (walk-elements (context-root context)
          (lambda (node)
            (when (element-id node)
              (setf (gethash (element-id node) visible-ids) t))))
        (maphash (lambda (id node)
                   (declare (ignore node))
                   (assert (gethash id visible-ids)))
                 (context-ids context)))
      (frame)
      (assert (= 1 actions))

      ;; Tab leaves the popup rather than visiting its detached rows.
      (setf (context-focus context) (gethash :file ids))
      (key :down)
      (frame (make-event :kind :tab))
      (assert (= 0 (depth)))
      (assert (equal (context-focus context) (gethash :after ids)))

      ;; Root arrows cycle within the same bar once the sibling is enabled.
      (setf disabled nil)
      (frame)
      (setf (context-focus context) (gethash :file ids))
      (key :down)
      (key :right)
      (assert (equal (aref (context-floating-path context) 0)
                     (gethash :edit ids)))
      (key :left)
      (assert (equal (aref (context-floating-path context) 0)
                     (gethash :file ids))))))

(defun test-floating-placement ()
  (let ((context (make-test-context))
        (root nil)
        (child nil)
        (item nil))
    (labels ((draw ()
               (setf root
                     (nth-value 2
                       (lui:menu "Root"
                           (lui:opt :position :absolute :offset-x 38
                                    :width (fixed 10)
                                    :popup-width (fixed 20))
                         (setf child
                               (nth-value 2
                                 (lui:menu "Child"
                                     (lui:opt :popup-width (fixed 20))
                                   (setf item
                                         (nth-value 2
                                           (lui:menu-item "Action"))))))))))
             (frame (&rest events)
               (with-frame (context 60 12 :events events) (draw)))
             (box (id) (element-box (gethash id (context-ids context)))))
      (frame)
      (frame (make-event :kind :activate :id root))
      (frame (make-event :kind :activate :id child))

      ;; Near the right edge, the submenu flips left and stays in the viewport.
      (assert (< (box-x (box item)) (box-x (box child))))
      (assert (<= 0 (box-x (box item))))
      (assert (<= (box-right (box item)) 60))
      (assert (<= 0 (box-y (box item))))
      (assert (<= (box-bottom (box item)) 12))

      ;; Removing the entire declaration drops both levels of retained state.
      (with-frame (context 60 12) (lui:label "Replaced"))
      (assert (zerop (length (context-floating-path context)))))))

(defun run-tests ()
  (test-floating-placement)
  (test-floating-menus)
  (test-spinner)
  (test-spacing-controls)
  (test-container-options)
  (test-password)
  (test-retained-editor-state)
  (test-scrollbar)
  (test-readline)
  (test-searchable-combobox)
  (test-tabs-and-hover)
  (test-radio-group)
  (test-keyboard-activation)
  (let ((context (make-test-context)))
    (with-frame (context 10 4)
      (%lui.widgets:declare-widget :splitter :glass :divider ""
                                 :width (fixed 2) :height (fixed 4)))
    (assert (eq :resize-horizontal
                (%lui.widgets:cursor-at context 1 1)))
    (assert (eq :default (%lui.widgets:cursor-at context 3 1))))
  (test-nested-scroll)
  (let ((context (make-test-context))
        (slider 0.0)
        (checked nil)
        (text "abc"))
    (flet ((draw ()
             (setf slider
               (lui:with-toolkit (:glass) (%lui.tests.support::draw-slider
                (lui:opt :id :slider :value slider :width (fixed 20)))))
             (setf checked (lui:with-toolkit (:glass)
                             (%lui.tests.support::draw-checkbox "Check"
                               (lui:opt :id :check :value checked))))
             (setf text (lui:with-toolkit (:motif)
                          (%lui.tests.support::draw-text-field (lui:opt :id
                  :text :value text))))))
      (with-frame (context 30 10) (draw))
      ;; Press/move/release can all arrive before the next UI invocation.
      (with-frame
          (context 30 10 :events
                   (list (make-event :kind :press :x 2 :y 0)
                         (make-event :kind :move :x 16 :y 0)
                         (make-event :kind :release :x 16 :y 0)))
        (draw))
      (assert (< (abs (- slider 0.8)) 0.001))
      (with-frame
          (context 30 10 :events (list (make-event :kind :move :x 1 :y 0)))
        (draw))
      (assert (< (abs (- slider 0.8)) 0.001))
      (with-frame
          (context 30 10 :events
                   (list (make-event :kind :change :id :check :value t)
                         (make-event :kind :key :id :text :key :select-all)
                         (make-event :kind :text :id :text
                                     :value "replacement")))
        (draw))
      (assert checked)
      (assert (string= text "replacement"))))
  (let ((context (make-test-context)))
    (flet ((draw ()
             (column (lui:opt :id :scroll :width (fixed 10) :height (fixed 2)
                      :scroll-p t)
               (lui.glass:label "first")
               (lui.glass:label "second")
               (lui.glass:label "third"))))
      (with-frame (context 10 3) (draw))
      (assert (not (visible-text-p context "third")))
      (with-frame
          (context 10 3 :events
                   (list (make-event :kind :scroll :x 1 :y 1 :value 1)))
        (draw))
      (assert (visible-text-p context "second"))
      (assert (visible-text-p context "third"))
      (assert (not (visible-text-p context "first")))))
  (let ((context (make-test-context)))
    (with-frame (context 20 5)
      (let ((now (frame-time)))
        (assert (null (context-next-frame context)))
        (request-frame 1)
        (request-frame 2)
        (assert (< (abs (- (- (context-next-frame context)
                              #+jscl now
                              #-jscl (coerce now 'double-float)) 1))
                   0.000001d0))
        (request-frame 0.25)
        (assert (< (abs (- (- (context-next-frame context)
                              #+jscl now
                              #-jscl (coerce now 'double-float)) 0.25d0))
                   0.000001d0))
        (assert (= now (frame-time)))))
    (with-frame (context 20 5)
      (assert (null (context-next-frame context))))
    ;; An epoch-sized clock must preserve a fractional single-float delay.
    (with-frame (context 20 5)
      (setf (%lui.frame::context-time context) 1800000000)
      (request-frame 1)
      (request-frame 2)
      (assert (= 1800000001d0 (context-next-frame context)))
      (request-frame 0.25)
      (assert (= 1800000000.25d0 (context-next-frame context)))
      (request-frame 0.5)
      (assert (= 1800000000.25d0 (context-next-frame context)))))
  (let ((context (make-test-context)) (received nil))
    (flet ((draw ()
             (setf received (events-for :canvas))
             (lui:with-toolkit (:glass) (%lui.tests.support::draw-canvas nil
              (lui:opt :id :canvas :width (fixed 10) :height (fixed 5))))
             (lui:with-toolkit (:glass) (%lui.tests.support::draw-gauge 0.5
                                          (lui:opt :id :gauge)))))
      (with-frame (context 20 10) (draw))
      (assert (typep received '(vector event)))
      (assert (zerop (length received)))
      (with-frame (context 20 10 :events
                           (list (make-event :kind :move :x 2 :y 2)))
        (draw))
      (assert (typep received '(vector event)))
      (assert (every (lambda (event) (typep event 'event)) received))
      (assert (= 1 (length received)))
      (assert (not (event-dragging-p (aref received 0))))
      (with-frame (context 20 10 :events
                           (list (make-event :kind :press :x 2 :y 2)
                                 (make-event :kind :release :x 19 :y 9)))
        (draw))
      (assert (equal '(:press :release) (map 'list #'event-kind received)))
      (assert (event-dragging-p (aref received 1)))
      (assert (not (gethash :canvas (context-activated context))))
      (with-frame (context 20 10 :events
                           (list (make-event :kind :press :x 2 :y 2
                                             :button :secondary)
                                 (make-event :kind :release :x 2 :y 2
                                             :button :secondary)))
        (draw))
      (assert (not (gethash :canvas (context-activated context))))
      (assert (null (lui:widget-key (context-active context))))
      (with-frame (context 20 10 :events
                           (list (make-event :kind :press :x 2 :y 2)
                                 (make-event :kind :release :x 2 :y 2)
                                 (make-event :kind :press :x 2 :y 2)))
        (draw))
      (assert (= 2 (event-clicks (aref received 2))))
      (assert (not (element-interactive-p
                     (gethash (lui:widget-id :gauge context)
                       (%lui.frame::context-ids context)))))))
  (let ((context (make-test-context)))
    (flet ((draw ()
             (column (lui:opt :id :grid :width (fixed 5) :height (fixed 5)
                      :scroll-p t)
               (emit (make-element :width (fixed 20)
                                   :height (fixed 20))))))
      (with-frame (context 10 10)
        (draw)
        (scroll-to :grid 100 100))
      (with-frame (context 10 10)
        (multiple-value-bind (x y) (scroll-position :grid)
          (assert (= x 15)) (assert (= y 15)))
        (scroll-to :grid 3 4)
        (draw))
      (with-frame (context 10 10)
        (multiple-value-bind (x y) (scroll-position :grid)
          (assert (= x 3)) (assert (= y 4)))
        (draw))))
  (let ((context (make-test-context)))
    (lui.toolkit:register-toolkit :terminal-square :defaults '(:radius 0))
    (with-frame (context 20 10)
      (lui:with-toolkit (:terminal-square)
        (%lui.tests.support::draw-button "Square" (lui:opt :id :square))
        (%lui.tests.support::draw-button "Round" (lui:opt :id :round :radius
                                                  4))))
    (flet ((text (id)
             (%lui.widgets:widget-terminal-text
               (element-content (gethash (lui:widget-id id context)
                                  (%lui.frame::context-ids context))))))
      (assert (string= "[ Square ]" (text :square)))
      (assert (string= "( Round )" (text :round)))))
  (format t "Widget interaction and scrolling checks passed.~%")
  t)
