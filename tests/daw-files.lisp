(defpackage #:%lui.tests.daw-files
  (:use #:cl)
  (:import-from #:%lui.example.daw-state
    #:session-song #:session-path #:session-dirty-p
    #:session-pending #:session-pending-path #:session-close-after-save-p
    #:session-status)
  (:import-from #:%lui.example.daw-demo
    #:request-file-action #:resolve-file-confirmation #:resolve-close)
  (:import-from #:%lui.example.daw-files #:*picker*)
  (:import-from #:%lui.tests.daw #:make-editor-session)
  (:export #:run-tests))
(in-package #:%lui.tests.daw-files)

(defun choose (session action path)
  "Drive a file action with a selected path or a canceled picker."
  (let ((*picker* (lambda (&rest arguments)
                   (declare (ignore arguments)) path)))
    (request-file-action session action)))

(defun test-save (directory)
  "First save, repeat save, cancellation and failed Save As preserve state."
  (let* ((session (make-editor-session :dirty-p t))
         (path (merge-pathnames "project with spaces.lisp" directory)))
    (choose session :save nil)
    (assert (string= "" (session-path session)))
    (assert (session-dirty-p session))
    (choose session :save path)
    (assert (probe-file path))
    (assert (equal (namestring path) (session-path session)))
    (assert (not (session-dirty-p session)))
    ;; Repeat saves never invoke a picker or request overwrite confirmation.
    (let ((*picker* (lambda (&rest arguments)
                     (declare (ignore arguments)) (error "Unexpected picker"))))
      (setf (session-dirty-p session) t)
      (request-file-action session :save)
      (assert (not (session-dirty-p session)))
      (assert (null (session-pending session))))
    (setf (session-dirty-p session) t)
    (choose session :save-as nil)
    (assert (string= (namestring path) (session-path session)))
    ;; A file cannot also be the parent directory of the new project.
    (choose session :save-as
            (merge-pathnames "project with spaces.lisp/child.lisp" directory))
    (assert (session-dirty-p session))
    (assert (string= (namestring path) (session-path session)))
    (assert (not (string= "Project saved." (session-status session))))))

(defun test-overwrite-and-open (directory)
  "Canceled overwrites and Open dialogs retain the active model and path."
  (let* ((path (merge-pathnames "project with spaces.lisp" directory))
         (session (make-editor-session :dirty-p t))
         (song (session-song session)))
    (choose session :save-as path)
    (assert (eq :save-as (session-pending session)))
    (assert (equal path (session-pending-path session)))
    (resolve-file-confirmation session :cancel)
    (assert (session-dirty-p session))
    (assert (string= "" (session-path session)))
    (choose session :load nil)
    (assert (eq song (session-song session)))
    (choose session :load path)
    (assert (eq :load (session-pending session)))
    (resolve-file-confirmation session :cancel)
    (assert (eq song (session-song session)))
    (choose session :load path)
    (resolve-file-confirmation session :confirm)
    (assert (not (eq song (session-song session))))
    (assert (string= (namestring path) (session-path session)))
    (assert (not (session-dirty-p session)))
    (choose session :new nil)
    (assert (string= "" (session-path session))))
  (let ((session (make-editor-session :dirty-p t))
        (path (merge-pathnames "invalid.lisp" directory)))
    (with-open-file (stream path :direction :output :if-exists :supersede)
      (write-line "invalid" stream))
    (let ((song (session-song session)))
      (choose session :load path)
      (resolve-file-confirmation session :confirm)
      (assert (eq song (session-song session)))
      (assert (session-dirty-p session))
      (assert (string= "" (session-path session))))))

(defun test-export (directory)
  "Export to a separate destination without changing the project identity."
  (let* ((session (make-editor-session :path "original.lisp" :dirty-p t))
         (path (merge-pathnames "mix.wav" directory)))
    (choose session :wav nil)
    (assert (not (probe-file path)))
    (choose session :wav path)
    (assert (probe-file path))
    (assert (string= "original.lisp" (session-path session)))
    (assert (session-dirty-p session))
    (choose session :wav path)
    (assert (eq :wav (session-pending session)))
    (resolve-file-confirmation session :cancel)))

(defun test-close (directory)
  "Canceled first-save pickers veto closing; confirmed saves allow it."
  (let* ((context (%lui.tests.support:make-test-context))
         (%lui.frame:*context* context)
         (session (make-editor-session :dirty-p t :pending :close))
         (path (merge-pathnames "close-save.lisp" directory)))
    (let ((*picker* (lambda (&rest arguments)
                     (declare (ignore arguments)) nil)))
      (resolve-close session :confirm))
    (assert (session-dirty-p session))
    (assert (not (%lui.frame:accept-close-p context)))
    (assert (not (session-close-after-save-p session)))
    (let ((*picker* (lambda (&rest arguments)
                     (declare (ignore arguments)) path)))
      (resolve-close session :confirm))
    (assert (probe-file path))
    (assert (%lui.frame:accept-close-p context))
    (assert (not (session-dirty-p session)))))

(defun test-picker-arguments (directory)
  "Supply extension filters and append missing extensions before writing."
  (let* ((session (make-editor-session))
         (path (merge-pathnames "extensionless" directory))
         (*picker* (lambda (open-p title default type)
                     (assert (not open-p))
                     (assert (string= title "Save project as"))
                     (assert (pathnamep default))
                     (assert (string= type "lisp"))
                     path)))
    (request-file-action session :save)
    (assert (probe-file (make-pathname :type "lisp" :defaults path))))
  (assert (string= "\"a\\\"b\\\\c\""
                   (%lui.example.daw-files:apple-string "a\"b\\c")))
  (let ((script (%lui.example.daw-files:macos-script
                 nil "Save" (merge-pathnames "a b.lisp" directory) "lisp")))
    (assert (search "choose file name" script))
    (assert (search "on error number -128" script))))

(defun test-close-overwrite (directory)
  "An overwrite decision during close still allows canceling or retrying."
  (let* ((context (%lui.tests.support:make-test-context))
         (%lui.frame:*context* context)
         (session (make-editor-session :dirty-p t :pending :close))
         (path (merge-pathnames "project with spaces.lisp" directory))
         (*picker* (lambda (&rest arguments)
                     (declare (ignore arguments)) path)))
    (resolve-close session :confirm)
    (assert (eq :save-as (session-pending session)))
    (resolve-file-confirmation session :cancel)
    (assert (session-dirty-p session))
    (assert (not (%lui.frame:accept-close-p context)))
    (assert (not (session-close-after-save-p session)))
    (resolve-close session :confirm)
    (resolve-file-confirmation session :confirm)
    (assert (not (session-dirty-p session)))
    (assert (%lui.frame:accept-close-p context))))

(defun run-tests ()
  "Exercise the DAW file workflow without opening desktop dialogs."
  (let ((directory
          (loop :for index :from 0
                :for path := (merge-pathnames
                              (format nil "build/daw-files-~D-~D/"
                                      (get-universal-time) index)
                              (uiop:getcwd))
                :unless (probe-file path) :return path)))
    (ensure-directories-exist directory)
    (test-save directory)
    (test-overwrite-and-open directory)
    (test-export directory)
    (test-close directory)
    (test-close-overwrite directory)
    (test-picker-arguments directory))
  (format t "DAW file dialogs, cancellation, save, export and close passed.~%"))
