(defpackage #:%lui.tests.retained-demo
  (:use #:cl)
  (:export #:run-tests))
(in-package #:%lui.tests.retained-demo)

(defun find-id (context key &optional value)
  "Find a completed demo widget by its declared key and optional editor value."
  (let ((found nil))
    (%lui.layout:walk-elements
     (%lui.frame:context-root context)
     (lambda (node)
       (let ((widget (%lui.layout:element-content node))
             (id (%lui.layout:element-id node)))
         (when (and (%lui.widgets:widget-p widget)
                    (equal key (lui:widget-key id))
                    (or (null value)
                        (equal value (%lui.widgets:widget-value widget))))
           (setf found id)))))
    (assert found)
    found))

(defun run-tests ()
  "Exercise real demo callbacks and check the following completed frame."
  (let ((context (%lui.tests.support:make-test-context))
        (draw (%lui.example.retained-demo:make-demo)))
    (labels ((frame (&optional events)
               (lui:with-frame (context 100 50 :events events)
                 (funcall draw)))
             (activate (key)
               (frame (list (%lui.frame:make-event
                             :kind :activate :id (find-id context key))))
               (frame))
             (has (text)
               (%lui.tests.support:has-text-p context text)))
      (frame)
      (assert (has "Clicks: 0"))
      (activate :count)
      (assert (has "Clicks: 1"))
      (frame (list (%lui.frame:make-event
                    :kind :text :id (find-id context :name) :value "!")))
      (frame)
      (assert (has "Hello, retained world!!"))
      (let ((id (find-id context :note "Note for item 1")))
        (frame (list (%lui.frame:make-event
                      :kind :text :id id :value " edited")))
        (activate :reverse)
        (assert (equal id (find-id context :note "Note for item 1 edited")))
        (assert (has "Row keys: (2 1)"))
        (activate :add)
        (assert (has "Row keys: (2 1 3)"))
        (assert (has "Note for item 3"))
        (activate :remove)
        (assert (not (has "Note for item 3")))
        (activate :remove)
        (activate :remove)
        (activate :remove)
        (assert (has "Row keys: NIL"))
        (activate :add)
        (assert (has "Note for item 4")))))
  (format t "Retained demo callbacks, queued edits and keyed rows passed.~%"))
