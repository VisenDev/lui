(defpackage #:lui.tests.debug
  (:use #:cl #:lui.fn #:lui #:lui.layout #:lui.frame #:lui.widgets
        #:lui.terminal)
  (:export #:run-tests))
(in-package #:lui.tests.debug)

(fn test-tree ()
  (let ((state (lui.debug:make-state :open-p t))
        (context (make-terminal-context)) (count 0) (show t) (page :a))
    (labels ((app ()
               (column (:id :app :width (grow) :height (grow) :scroll-p t)
                 (when show
                   (when (lui.glass:button :action "Action"
                                           :width (grow)
                                           :height (fixed 1))
                     (incf count)))
                 (row (:width (grow))
                   (when (lui.glass:tab :tab-a "A" :selected-p (eq page :a))
                     (setf page :a))
                   (when (lui.glass:tab :tab-b "B" :selected-p (eq page :b))
                     (setf page :b)))
                 (dotimes (i 200)
                   (lui.glass:label (format nil "Row ~D" i)))))
             (frame (&rest events)
               (with-frame (context 80 36 :events events)
                 (lui.debug:draw #'app :state state)))
             (node (id)
               (gethash id (lui.frame::context-ids context)))
             (row-count ()
               (let ((count 0))
                 (walk-elements
                  (context-root context)
                  (lambda (node)
                    (let ((id (element-id node)))
                      (when (and (consp id) (eq (first id) :lui.debug)
                                 (eq (second id) :row))
                        (incf count)))))
                 count)))
      ;; First-open rendering requests its first completed geometry snapshot.
      (frame)
      (assert (context-next-frame context))
      (frame)
      (assert (node (lui.debug::id :inspector)))
      (assert (< 1 (row-count) 30))
      (assert (search "- " (render-terminal context)))
      (let* ((rows (lui.debug::state-rows state))
             (last (lui.debug::entry-node (aref rows (1- (length rows))))))
        (assert (search "[offscreen]" (lui.debug::caption last))))
      (let ((rows (length (lui.debug::state-rows state))))
        (frame)
        (assert (= rows (length (lui.debug::state-rows state)))))
      ;; Own inspector descendants are never included in the app snapshot.
      (maphash (lambda (key node)
                 (declare (ignore key))
                 (assert (not (lui.debug::own-node-p node))))
               (lui.debug::state-nodes state))
      (let ((key '(:id :action)))
        (frame (make-event :kind :activate :id (lui.debug::id :row key)))
        (assert (equal key (lui.debug:state-selected state)))
        (assert (search "Bounds:" (render-terminal context)))
        (setf (context-hover context) (lui.debug::id :row key))
        (frame)
        (let ((highlight (node (lui.debug::id :bounds))))
          (assert highlight)
          (assert (not (element-interactive-p highlight))))
        ;; The highlight is transparent to native/core pointer hit testing.
        (frame (make-event :kind :press :x 1 :y 0)
               (make-event :kind :release :x 1 :y 0))
        (assert (= 1 count))
        (setf show nil)
        (frame)
        (frame)
        (assert (null (lui.debug:state-selected state))))
      ;; Empty inspector area captures input instead of clicking the app behind.
      (setf show t)
      (frame)
      (let* ((pane (node (lui.debug::id :inspector)))
             (box (element-box pane)))
        (frame (make-event :kind :press :x (+ (box-x box) 0.25) :y 0)
               (make-event :kind :release :x (+ (box-x box) 0.25) :y 0))
        (assert (= 1 count))
        (assert (not (equal (context-hover context) :action))))
      ;; App tab navigation consumes the frame root; the inspector must persist.
      (setf (context-focus context) :tab-a)
      (frame (make-event :kind :key :key :right))
      (assert (eq page :b))
      (assert (node (lui.debug::id :inspector)))
      ;; Background capture must not introduce a keyboard focus stop.
      (setf (context-focus context) :tab-b)
      (frame (make-event :kind :tab))
      (assert (equal (context-focus context) (lui.debug::id :close)))
      (frame (make-event :kind :tab :key :backward))
      (assert (eq (context-focus context) :tab-b))
      ;; Visible disclosure controls really collapse and expand their subtree.
      (frame (make-event :kind :activate
                         :id (lui.debug::id :collapse '(:id :app))))
      (frame)
      (assert (< (length (lui.debug::state-rows state)) 5))
      (assert (search "+ " (render-terminal context)))
      (frame (make-event :kind :activate
                         :id (lui.debug::id :collapse '(:id :app))))
      (frame)
      (assert (> (length (lui.debug::state-rows state)) 200))
      ;; A shrink while scrolled must still emit the remaining visible rows.
      (with-frame (context 80 36)
        (scroll-to (lui.debug::id :tree) 0 300)
        (lui.debug:draw #'app :state state))
      (setf (gethash '(:id :app) (lui.debug::state-collapsed state)) t)
      (frame)
      (assert (< (length (lui.debug::state-rows state)) 5))
      (assert (plusp (row-count)))
      (setf (lui.debug:state-open-p state) nil)
      (frame)
      (assert (null (node (lui.debug::id :inspector)))))))

(fn test-overlay ()
  (let ((context (make-terminal-context)) (plain nil) (ansi nil))
    (labels ((text ()
               (lui.glass:cell :background "" :floating-p t :disabled-p t
                               :width (fixed 10) :height (fixed 3)
                               :background "#303040")
               (lui.glass:label "ABCDEFGHIJ"
                                :width (fixed 10) :height (fixed 3)))
             (overlay (opacity)
               (emit (make-element
                      :id :overlay :floating-p t :width (fixed 10)
                      :height (fixed 3)
                      :content (make-widget :kind :highlight :opacity opacity
                                            :accent "#ff8c00")))))
      (with-frame (context 10 3) (text))
      (setf plain (render-terminal context)
            ansi (render-terminal context :ansi t))
      (with-frame (context 10 3) (text) (overlay 0.18))
      (assert (equal plain (render-terminal context)))
      (assert (search "[48;2;255;140;0m"
                       (render-terminal context :ansi t)))
      (with-frame (context 10 3) (text) (overlay 0))
      (assert (equal plain (render-terminal context)))
      (let ((colored (render-terminal context :ansi t)))
        (assert (search "[48;2;255;140;0m" colored))
        ;; The middle row's interior retains its unhighlighted background.
        (assert (search "[48;2;48;48;64m" colored)))
      (assert (not (equal ansi (render-terminal context :ansi t)))))))

(fn test-resizing ()
  (let ((state (lui.debug:make-state :open-p t))
        (context (make-terminal-context)) (window 80))
    (labels ((frame (&rest events)
               (with-frame (context window 36 :events events)
                 (lui.debug:draw (lambda () (lui.glass:label "App"))
                                 :state state)))
             (width ()
               (box-width
                (element-box
                 (gethash (lui.debug::id :inspector)
                          (lui.frame::context-ids context))))))
      (frame) (frame)
      (assert (= 32 (width)))
      (frame (make-event :kind :move :x 48 :y 10))
      (assert (null (lui.debug:state-width state)))
      (frame (make-event :kind :press :x 48.25 :y 10))
      (assert (= 32 (width)))
      (frame (make-event :kind :move :x 20.25 :y 10 :dragging-p t))
      (assert (= 60 (width)))
      (frame (make-event :kind :release :x 20.25 :y 10))
      (assert (null (lui.debug::state-grab state)))
      (setf (lui.debug:state-open-p state) nil)
      (frame)
      (setf (lui.debug:state-open-p state) t)
      (frame)
      (assert (= 60 (width)))
      (setf window 50)
      (frame) (frame)
      (assert (= 38 (width)))
      (setf window 80)
      (frame) (frame)
      (assert (= 60 (width)))
      (frame (make-event :kind :key :id (lui.debug::id :resize) :key :home))
      (assert (= 25 (width)))
      (frame (make-event :kind :key :id (lui.debug::id :resize) :key :left))
      (assert (= 27 (width)))
      (frame (make-event :kind :key :id (lui.debug::id :resize) :key :end))
      (assert (= 68 (width)))
      (frame (make-event :kind :key :id (lui.debug::id :resize) :key :right))
      (assert (= 66 (width))))))

(fn test-terminal-overlap ()
  (let ((context (make-terminal-context)) (expected nil))
    (flet ((front ()
             (lui.glass:panel (:floating-p t :width (fixed 20)
                               :height (fixed 8) :padding 1)
               (lui.glass:label (format nil "Front~%Second~%Third")))))
      (with-frame (context 20 8) (front))
      (setf expected (render-terminal context))
      (with-frame (context 20 8)
        (lui.glass:panel (:width (fixed 20) :height (fixed 3))
          (lui.glass:label "Behind"))
        (front))
      (assert (equal expected (render-terminal context))))))

(fn run-tests ()
  (test-terminal-overlap)
  (test-resizing)
  (test-tree)
  (test-overlay)
  (format t "Debugger snapshots, virtual rows, details and overlays passed.~%")
  t)
