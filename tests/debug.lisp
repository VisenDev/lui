(defpackage #:%lui.tests.debug
  (:use #:cl #:%lui.fn #:lui #:%lui.layout #:%lui.frame #:%lui.widgets
        #:%lui.tests.support)
  (:export #:run-tests))
(in-package #:%lui.tests.debug)

(fn test-tree ()
  (let ((state (lui.debug:make-debugger-state))
        (context (make-test-context)) (count 0) (show t) (page :a))
    (lui.debug:set-debugger-enabled t :context context :state state)
    (labels ((app ()
               (column (lui:opt :id :app :width (grow) :height (grow)
                 :scroll-p t)
                 (when show
                   (when (lui:with-toolkit (:glass)
                           (%lui.tests.support::draw-button "Action" (lui:opt
                      :id :action :width (grow)
                      :height (fixed 1))))
                     (incf count)))
                 (row (lui:opt :width (grow))
                   (when (lui:with-toolkit (:glass)
                           (%lui.tests.support::draw-tab "A" (lui:opt :id
                      :tab-a :selected-p (eq page :a))))
                     (setf page :a))
                   (when (lui:with-toolkit (:glass)
                           (%lui.tests.support::draw-tab "B" (lui:opt :id
                      :tab-b :selected-p (eq page :b))))
                     (setf page :b)))
                 (dotimes (i 200)
                   (lui.glass:label (format nil "Row ~D" i)))))
             (frame (&rest events)
               (with-frame (context 80 36 :events events)
                 (app)))
             (node (id)
               (gethash (lui:widget-id id context) (%lui.frame::context-ids
                context)))
             (row-count ()
               (let ((count 0))
                 (walk-elements
                  (context-root context)
                  (lambda (node)
                     (let ((id (lui:widget-key (element-id node))))
                      (when (and (consp id) (eq (first id) :lui.debug)
                                 (eq (second id) :row))
                        (incf count)))))
                 count)))
      ;; First-open rendering requests its first completed geometry snapshot.
      (frame)
      (assert (context-next-frame context))
      (frame)
      (assert (node (lui.debug::id :debugger)))
      (assert
       (string= "Layout debugger"
                (widget-text
                 (element-content
                  (aref (element-children (node (lui.debug::id :header)))
                        0)))))
      (assert (string= "Debugger width"
                       (widget-text
                        (element-content (node (lui.debug::id :resize))))))
      (assert (< 1 (row-count) (1+ (context-height context))))
      (assert (string= "-" (widget-text
                            (element-content
                               (node (lui.debug::id :collapse (list :id
                    (lui:widget-id :app context))))))))
      (let* ((rows (lui.debug::debugger-state-rows state))
             (last (lui.debug::entry-node (aref rows (1- (length rows))))))
        (assert (search "[offscreen]" (lui.debug::caption last))))
      (let ((rows (length (lui.debug::debugger-state-rows state))))
        (frame)
        (assert (= rows (length (lui.debug::debugger-state-rows state)))))
      ;; Own debugger descendants are never included in the app snapshot.
      (maphash (lambda (key node)
                 (declare (ignore key))
                 (assert (not (lui.debug::own-node-p node))))
               (lui.debug::debugger-state-nodes state))
      (let ((key (list :id (lui:widget-id :action context))))
        (frame (make-event :kind :activate :id (lui.debug::id :row key)))
        (assert (equal key (lui.debug:debugger-state-selected state)))
        (assert (visible-text-p context "Bounds:"))
        (setf (context-hover context) (lui:widget-id (lui.debug::id :row key)
                                        context))
        (frame)
        (let ((highlight (node (lui.debug::id :bounds))))
          (assert highlight)
          (assert (not (element-interactive-p highlight))))
        ;; The highlight is transparent to native/core pointer hit testing.
        (frame (make-event :kind :press :x 1 :y 0)
               (make-event :kind :release :x 1 :y 0))
        (assert (= 1 count))
        (setf show nil)
        (frame)
        (frame)
        (assert (null (lui.debug:debugger-state-selected state))))
      ;; Empty debugger area captures input instead of clicking the app behind.
      (setf show t)
      (frame)
      (let* ((pane (node (lui.debug::id :debugger)))
             (box (element-box pane)))
        (frame (make-event :kind :press :x (+ (box-x box) 0.25) :y 0)
               (make-event :kind :release :x (+ (box-x box) 0.25) :y 0))
        (assert (= 1 count))
        (assert (not (equal (lui:widget-key (context-hover context))
                       :action))))
      ;; App tab navigation consumes the frame root; the debugger must persist.
      (setf (context-focus context) (lui:widget-id :tab-a context))
      (frame (make-event :kind :key :key :right))
      (assert (eq page :b))
      (assert (node (lui.debug::id :debugger)))
      ;; Background capture must not introduce a keyboard focus stop.
      (setf (context-focus context) (lui:widget-id :tab-b context))
      (frame (make-event :kind :tab))
      (assert (equal (lui:widget-key (context-focus context)) (lui.debug::id
              :close)))
      (frame (make-event :kind :tab :key :backward))
      (assert (eq (lui:widget-key (context-focus context)) :tab-b))
      ;; Visible disclosure controls really collapse and expand their subtree.
      (frame (make-event :kind :activate
               :id (lui.debug::id :collapse (list :id
                                              (lui:widget-id :app context)))))
      (frame)
      (assert (< (length (lui.debug::debugger-state-rows state)) 5))
      (assert (string= "+" (widget-text
                            (element-content
                               (node (lui.debug::id :collapse (list :id
                    (lui:widget-id :app context))))))))
      (frame (make-event :kind :activate
               :id (lui.debug::id :collapse (list :id
                                              (lui:widget-id :app context)))))
      (frame)
      (assert (> (length (lui.debug::debugger-state-rows state)) 200))
      ;; A shrink while scrolled must still emit the remaining visible rows.
      (with-frame (context 80 36)
        (scroll-to (lui.debug::id :tree) 0 300)
        (app))
      (setf (gethash (list :id (lui:widget-id :app context))
              (lui.debug::debugger-state-collapsed state)) t)
      (frame)
      (assert (< (length (lui.debug::debugger-state-rows state)) 5))
      (assert (plusp (row-count)))
      (lui.debug:set-debugger-enabled nil :context context)
      (frame)
      (assert (null (node (lui.debug::id :debugger)))))))

(fn test-resizing ()
  (let ((state (lui.debug:make-debugger-state))
        (context (make-test-context)) (window 80))
    (lui.debug:set-debugger-enabled t :context context :state state)
    (labels ((frame (&rest events)
               (with-frame (context window 36 :events events)
                 (lui.glass:label "App")))
             (width ()
               (box-width
                (element-box
                   (gethash (lui:widget-id (lui.debug::id :debugger) context)
                          (%lui.frame::context-ids context))))))
      (frame) (frame)
      (assert (= 32 (width)))
      (frame (make-event :kind :move :x 48 :y 10))
      (assert (null (lui.debug:debugger-state-width state)))
      (frame (make-event :kind :press :x 48.25 :y 10))
      (assert (= 32 (width)))
      (frame (make-event :kind :move :x 20.25 :y 10 :dragging-p t))
      (assert (= 60 (width)))
      (frame (make-event :kind :release :x 20.25 :y 10))
      (assert (null (lui.debug::debugger-state-grab state)))
      (lui.debug:set-debugger-enabled nil :context context)
      (frame)
      (lui.debug:set-debugger-enabled t :context context)
      (frame)
      (assert (= 60 (width)))
      (setf window 50)
      (frame) (frame)
      (assert (= 38 (width)))
      (setf window 80)
      (frame) (frame)
      (assert (= 60 (width)))
      (frame (make-event :kind :key :id (lui.debug::id :resize) :key :home))
      (assert (= 25 (width)))
      (frame (make-event :kind :key :id (lui.debug::id :resize) :key :left))
      (assert (= 27 (width)))
      (frame (make-event :kind :key :id (lui.debug::id :resize) :key :end))
      (assert (= 68 (width)))
      (frame (make-event :kind :key :id (lui.debug::id :resize) :key :right))
      (assert (= 66 (width))))))

(fn test-properties ()
  (let ((state (lui.debug:make-debugger-state))
        (context (make-test-context)) (lui:*unit* 1))
    (lui.debug:set-debugger-enabled t :context context :state state :toolkit
      :garnet)
    (labels ((frame (&rest events)
               (with-frame (context 100 48 :events events)
                 (lui:with-toolkit (:garnet)
                   (%lui.tests.support::draw-text-field (lui:opt :id :field
                                                         :value "Actual editor value"
                                            :background "#d0e0f0"
                                            :foreground "#101020")))))
             (node (name)
               (gethash (lui:widget-id (lui.debug::id name) context)
                        (%lui.frame::context-ids context)))
             (labels-named (text)
               (let ((found nil))
                 (walk-elements
                  (context-root context)
                  (lambda (node)
                    (let ((widget (element-content node)))
                      (when (and (widget-p widget)
                                 (eq (widget-kind widget) :label)
                                 (string= text (widget-text widget)))
                        (push widget found)))))
                 found)))
      (frame) (frame)
      (assert (null (node :details)))
      (let ((initial (box-height (element-box (node :tree)))))
        (frame (make-event :kind :activate
                 :id (lui.debug::id :row (list :id (lui:widget-id
                                                     :field context)))))
        (assert (node :details))
        (assert (< (box-height (element-box (node :tree))) (* 0.5 initial))))
      (dolist (title '("Geometry" "Layout" "Appearance" "Content" "Input"))
        (assert (labels-named title)))
      (assert (labels-named "Actual editor value"))
      (assert (labels-named "#d0e0f0"))
      (assert (labels-named "Toolkit:"))
      (assert (null (labels-named "Collection:")))
      (assert (labels-named "Idle"))
      (assert (null (labels-named "Position:")))
      (assert (null (labels-named "Scroll:")))
      (assert (every (lambda (widget)
                       (eq :normal (widget-font-weight widget)))
                     (labels-named "Actual editor value")))
      (assert (string= "×"
                       (widget-text (element-content (node :close-details)))))
      (assert (string= "Close details"
                       (widget-accessible-name
                        (element-content (node :close-details)))))
      (assert (eq :horizontal
                  (widget-orientation
                   (element-content (node :details-resize)))))
      (let ((split (box-height (element-box (node :property-pane)))))
        (frame (make-event :kind :key :id (lui.debug::id :details-resize)
                           :key :up))
        (assert (> (box-height (element-box (node :property-pane))) split))
        (frame (make-event :kind :key :id (lui.debug::id :details-resize)
                           :key :down))
        (assert (= (box-height (element-box (node :property-pane))) split)))
      (frame (make-event :kind :key :id (lui.debug::id :details-resize)
                         :key :home))
      (assert (node :tree))
      (assert (equal (list :id (lui:widget-id :field context))
                (lui.debug:debugger-state-selected state)))
      (frame (make-event :kind :activate
               :id (lui.debug::id :row (list :id (lui:widget-id
                                                   :field context)))))
      (assert (null (lui.debug:debugger-state-selected state)))
      (assert (null (node :details)))
      (frame (make-event :kind :activate
               :id (lui.debug::id :row (list :id (lui:widget-id
                                                   :field context)))))
      (frame (make-event :kind :activate
                         :id (lui.debug::id :close-details)))
      (assert (lui.debug:debugger-state-open-p state))
      (assert (null (lui.debug:debugger-state-selected state)))
      (assert (null (lui.debug::debugger-state-details-height state)))
      (assert (node :tree))
      (assert (null (node :details)))
      ;; Anonymous nodes must not look focused/pressed just because IDs are NIL.
      (setf (lui.debug:debugger-state-selected state) '(:path nil nil))
      (frame)
      (assert (labels-named "Idle"))
      (assert (null (labels-named "Focused")))
      (assert (null (labels-named "Pressed")))))
  (assert (= 163 (length (lui.debug::property-text
                          (make-string 1000 :initial-element #\x)))))
  (assert (< (length (lui.debug::property-text
                      (make-list 1000 :initial-element '(1 2 3)))) 150)))

(fn test-selection-reveal ()
  (let ((state (lui.debug:make-debugger-state))
        (context (make-test-context)) (lui:*unit* 1)
        (key nil))
    (lui.debug:set-debugger-enabled t :context context :state state)
    (labels ((app ()
               (column (lui:opt :id :app :width (grow) :height (grow))
                 (dotimes (i 50)
                   (%lui.tests.support::draw-button (format nil "Item ~D" i)
                     (lui:opt :id (list :item i) :height (fixed 1))))))
             (frame (&rest events)
               (with-frame (context 80 36 :events events)
                 (app)))
             (selected ()
               (gethash (lui:widget-id (lui.debug::id :row key) context)
                        (%lui.frame::context-ids context))))
      (frame) (frame)
      (setf key (list :id (lui:widget-id '(:item 20) context)))
      (setf (lui.debug:debugger-state-selected state) key)
      (frame)
      (setf (lui.debug::debugger-state-reveal-selection-p state) t)
      (frame)
      (let ((clip (element-clip (selected))))
        (assert (= 1 (box-height clip)))
        ;; The same visible row can immediately dismiss its properties.
        (let ((x (+ (box-x clip) (/ (box-width clip) 2)))
              (y (+ (box-y clip) 0.5)))
          (frame (make-event :kind :press :x x :y y)
                 (make-event :kind :release :x x :y y))))
      (assert (null (lui.debug:debugger-state-selected state)))
      (frame (make-event :kind :activate :id (lui.debug::id :row key)))
      (frame)
      (with-frame (context 80 36)
        (scroll-to (lui.debug::id :tree) 0 0)
        (app))
      ;; Automatic reveal runs once per selection, preserving later scrolling.
      (with-frame (context 80 36)
        (assert (zerop (nth-value 1 (scroll-position (lui.debug::id :tree)))))
        (app)))))

(fn test-details-drag ()
  (let ((state (lui.debug:make-debugger-state))
        (context (make-test-context)) (lui:*unit* 1))
    (lui.debug:set-debugger-enabled t :context context :state state)
    (labels ((frame (&rest events)
               (with-frame (context 100 48 :events events)
                 (%lui.tests.support::draw-button "Item" (lui:opt :id :item))))
             (node (kind)
               (gethash (lui:widget-id (lui.debug::id kind) context)
                        (%lui.frame::context-ids context)))
             (select ()
               (frame (make-event :kind :activate
                        :id (lui.debug::id :row (list :id
                  (lui:widget-id :item context)))))
               (frame)))
      (frame) (frame) (select)
      (let* ((rail (element-box (node :details-resize)))
             (x (+ (box-x rail) 2)) (y (+ (box-y rail) 0.5))
             (height (box-height (element-box (node :property-pane)))))
        (frame (make-event :kind :press :x x :y y))
        (assert (= height (box-height (element-box (node :property-pane)))))
        (frame (make-event :kind :move :x x :y (- y 3)))
        (assert (= (+ height 3)
                   (box-height (element-box (node :property-pane)))))
        (frame (make-event :kind :release :x x :y (- y 3)))
        (assert (null (lui.debug::debugger-state-details-grab state))))
      (let* ((rail (element-box (node :details-resize)))
             (x (+ (box-x rail) 2)) (y (+ (box-y rail) 0.5)))
        (frame (make-event :kind :press :x x :y y))
        (frame (make-event :kind :move :x x :y 48))
        (frame (make-event :kind :release :x x :y 48)))
      (assert (null (lui.debug:debugger-state-selected state)))
      (assert (null (node :details)))
      (assert (node :tree))
      (select)
      (assert (> (box-height (element-box (node :property-pane))) 6))
      (frame (make-event :kind :key :id (lui.debug::id :details-resize)
                         :key :end))
      (assert (null (node :details)))
      (assert (null (lui.debug:debugger-state-selected state))))))

(fn test-header-clipping ()
  (dolist (compact '(nil t))
    (dolist (style '(:glass :motif :garnet))
      (let* ((lui:*unit* (if compact 1 8))
             (width (if compact 100 800))
             (height (if compact 48 520))
             (context
               (if compact (make-test-context)
                   (make-context
                    :measure
                    (lambda (widget available)
                      ;; Deliberately tall controls catch fixed chrome guesses.
                      (let* ((label (eq :label (widget-kind widget)))
                             (extra (if label 0 24))
                             (text-width (* 8 (length (widget-text widget))))
                             (line-width (max 1 (- (or available
                                                       (+ text-width extra))
                                                   extra)))
                             (lines (max 1 (ceiling text-width line-width)))
                             (line-height (if (eq style :garnet) 26 20)))
                        (values (+ text-width extra)
                                (+ (* lines line-height)
                                   (if label 0 16))))))))
             (state (lui.debug:make-debugger-state)))
        (lui.debug:set-debugger-enabled t :context context :state state
          :toolkit style)
        (labels ((frame (&rest events)
                   (with-frame (context width height :events events)
                     (%lui.tests.support::draw-button "Item" (lui:opt :id
                                                              :item))))
                 (node (name)
                   (gethash (lui:widget-id (lui.debug::id name) context)
                            (%lui.frame::context-ids context)))
                 (fully-visible (node)
                   (let ((box (element-box node))
                         (clip (element-clip node)))
                     (assert (>= (box-height clip) (box-height box)))
                     (assert (>= (box-width clip) (box-width box)))
                     (assert
                      (<= (nth-value 1
                            (funcall (element-measure node) (box-width box)))
                          (box-height box))))))
          (frame) (frame)
          (frame (make-event :kind :activate
                   :id (lui.debug::id :row (list :id (lui:widget-id
                                                       :item context)))))
          ;; Check the reported width and the narrow, wrapped-title variant.
          (dolist (sidebar-width '(40 25))
            (setf (lui.debug:debugger-state-width state) sidebar-width)
            (frame (make-event :kind :key :key :home
                               :id (lui.debug::id :details-resize)))
            (fully-visible (node :close))
            (fully-visible (aref (element-children (node :header)) 0))
            (let ((pane (element-box (node :property-pane))))
              (assert (<= (+ (box-y pane) (box-height pane))
                          (- height (units 1)))))
            (when compact
              (assert (visible-text-p context "Close"))))
          (frame (make-event :kind :activate :id (lui.debug::id :close)))
          (assert (not (lui.debug:debugger-state-open-p state))))))))

(fn test-divider-cancellation ()
  (let ((context (make-test-context))
        (state (lui.debug:make-debugger-state)) (lui:*unit* 1))
    (lui.debug:set-debugger-enabled t :context context :state state)
    (labels ((frame (&rest events)
               (with-frame (context 100 48 :events events)
                 (%lui.tests.support::draw-button "Item" (lui:opt :id :item))))
             (node (name)
               (gethash (lui:widget-id (lui.debug::id name) context)
                        (%lui.frame::context-ids context)))
             (extent (axis)
               (if (eq axis :resize)
                   (box-width (element-box (node :debugger)))
                   (box-height (element-box (node :property-pane)))))
             (grab (axis)
               (if (eq axis :resize) (lui.debug::debugger-state-grab state)
                   (lui.debug::debugger-state-details-grab state)))
             (point (axis)
               (let ((box (element-box (node axis))))
                 (values (+ (box-x box) (/ (box-width box) 2))
                         (+ (box-y box) (/ (box-height box) 2)))))
             (input (kind axis x y delta buttons)
               (make-event :kind kind :buttons buttons
                           :x (- x (if (eq axis :resize) delta 0))
                           :y (- y (if (eq axis :details-resize) delta 0)))))
      (frame) (frame)
      (frame (make-event :kind :activate
               :id (lui.debug::id :row (list :id (lui:widget-id
                                                   :item context)))))
      (dolist (axis '(:resize :details-resize))
        (multiple-value-bind (x y) (point axis)
          (let ((before (extent axis)))
            (frame (input :press axis x y 0 1))
            (assert (grab axis))
            (frame (input :move axis x y 3 1))
            (assert (= (+ before 3) (extent axis)))
            ;; The release was lost. Physical unpressed motion must cancel it.
            (frame (input :move axis x y 9 0))
            (assert (= (+ before 3) (extent axis)))
            (assert (null (grab axis)))
            (assert (null (lui:widget-key (context-active context))))
            (assert (not (gethash (lui.debug::id axis)
                                 (context-activated context))))))
        (multiple-value-bind (x y) (point axis)
          (let ((before (extent axis)))
            (frame (input :move axis x y 0 0))
            (assert (= before (extent axis)))
            (frame (input :press axis x y 0 1))
            (frame (input :move axis x y 1 1))
            ;; The final release coordinate still contributes to a normal drag.
            (frame (input :release axis x y 2 0))
            (assert (= (+ before 2) (extent axis)))
            (assert (null (grab axis)))))
        (multiple-value-bind (x y) (point axis)
          (frame (input :press axis x y 0 1))
          (frame (input :move axis x y 1 1))
          (let ((before (extent axis)))
            (frame (make-event :kind :cancel :buttons 0))
            (assert (= before (extent axis)))
            (assert (null (grab axis)))
            (assert (null (lui:widget-key (context-active context))))
            (frame (input :move axis x y 6 1))
            (assert (= before (extent axis)))))
        (multiple-value-bind (x y) (point axis)
          (let ((before (extent axis)))
            (frame (input :press axis x y 0 1))
            (frame (input :release axis x y 1 0))
            (assert (= (+ before 1) (extent axis)))))))))

(fn test-caption-cache ()
  (let* ((context (make-test-context))
         (text (copy-seq "Alpha"))
         (widget (make-widget :kind :label :text text))
         (node (make-element :content widget :box (make-box :width 10 :height
              1)
                             :clip (make-box :width 10 :height 1)))
         (first nil) (second nil))
    (flet ((caption ()
             (with-frame (context 80 36)
               (setf second (lui.debug::caption node)))))
      (caption)
      (setf first second)
      (caption)
      (assert (eq first second))
      (setf (char text 0) #\O)
      (caption)
      (assert (search "Olpha" second))
      (assert (not (eq first second)))
      (setf (box-width (element-clip node)) 5)
      (caption)
      (assert (search "[clipped]" second))
      (setf (box-width (element-clip node)) 0)
      (caption)
      (assert (search "[offscreen]" second))
      (setf (element-id node) '(:new 42))
      (caption)
      (assert (search "NEW" second))
      #-jscl (let ((*print-case* :downcase))
        (caption)
        (assert (search "new" second)))
      (setf (widget-kind widget) :button)
      (caption)
      (assert (search "BUTTON" second)))))

(fn test-page-viewport ()
  (let ((context (make-test-context)) (state (lui.debug:make-debugger-state)))
    (setf (%lui.frame::context-page-height-p context) t)
    (lui.debug:set-debugger-enabled t :context context :state state)
    (labels ((frame ()
               (with-frame (context 80 36)
                 (column (lui:opt :id :app :width (grow))
                   (dotimes (i 200)
                     (lui:label (format nil "Row ~D" i)
                                (lui:opt :height (fixed 10)))))))
             (box (name)
               (element-box (gethash (lui:widget-id (lui.debug::id name)
                                       context)
                                    (%lui.frame::context-ids context)))))
      (frame) (frame)
      (setf (%lui.frame::context-page-top context) 500)
      (frame) (frame)
      (assert (> (context-height context) 1000))
      (assert (= 36 (box-height (box :debugger)) (box-height (box :resize))))
      (assert (= 500 (box-y (box :debugger)) (box-y (box :resize))))
      (assert (< (box-height (box :tree)) 36))
      (let ((rows 0))
        (maphash (lambda (key node)
                   (declare (ignore node))
                   (setf key (lui:widget-key key))
                   (when (and (consp key) (eq (first key) :lui.debug)
                              (eq (second key) :row))
                     (incf rows)))
                 (%lui.frame::context-ids context))
        (assert (< 1 rows 38)))
      (setf (lui.debug:debugger-state-selected state) (list :id
          (lui:widget-id :app context)))
      (frame)
      (assert (< (box-height (box :property-pane)) 36))
      (lui.debug:set-debugger-enabled nil :context context)
      (frame)
      (assert (zerop (length (%lui.frame::context-memo context)))))))

(fn run-tests ()
  (test-caption-cache)
  (test-page-viewport)
  (test-divider-cancellation)
  (test-header-clipping)
  (test-details-drag)
  (test-selection-reveal)
  (test-properties)
  (test-resizing)
  (test-tree)
  (format t
    "Debugger snapshots, virtual rows, details and clipping passed.~%")
  t)
