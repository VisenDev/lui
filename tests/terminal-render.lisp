(defpackage #:lui.tests.terminal-render
  (:use #:cl #:lui.fn #:lui #:lui.layout #:lui.frame #:lui.widgets #:lui.terminal)
  (:export #:run-tests))
(in-package #:lui.tests.terminal-render)

(fn test-overlay ()
  (let ((context (make-terminal-context)) (plain nil) (ansi nil))
    (labels ((text ()
               (lui.glass:cell :background ""
                (lui:opt :floating-p t :disabled-p t
                         :width (fixed 10) :height (fixed 3)
                         :background "#303040"))
               (lui.glass:label "ABCDEFGHIJ"
                                (lui:opt :width (fixed 10) :height (fixed 3))))
             (overlay (opacity)
               (emit (make-element
                      :id :overlay :floating-p t :width (fixed 10)
                      :height (fixed 3)
                      :content (make-widget :kind :highlight :opacity opacity
                                            :accent "#ff8c00")))))
      (with-frame (context 10 3) (text))
      (setf plain (render-terminal context)
            ansi (render-terminal context :ansi t))
      (with-frame (context 10 3) (text) (overlay 0.18))
      (assert (equal plain (render-terminal context)))
      ;; Uncursed may combine background/foreground and emphasis in one SGR.
      (assert (search "48;2;255;140;0"
                       (render-terminal context :ansi t)))
      (with-frame (context 10 3) (text) (overlay 0))
      (assert (equal plain (render-terminal context)))
      (let ((colored (render-terminal context :ansi t)))
        (assert (search "48;2;255;140;0" colored))
        ;; The middle row's interior retains its unhighlighted background.
        (assert (search "48;2;48;48;64" colored)))
      (assert (not (equal ansi (render-terminal context :ansi t)))))))

(fn test-terminal-overlap ()
  (let ((context (make-terminal-context)) (expected nil))
    (flet ((front ()
             (lui.glass:panel (lui:opt :floating-p t :width (fixed 20)
                                       :height (fixed 8) :padding 1)
               (lui.glass:label (format nil "Front~%Second~%Third")))))
      (with-frame (context 20 8) (front))
      (setf expected (render-terminal context))
      (with-frame (context 20 8)
        (lui.glass:panel (lui:opt :width (fixed 20) :height (fixed 3))
          (lui.glass:label "Behind"))
        (front))
      (assert (equal expected (render-terminal context))))))

(fn test-panel-input-style ()
  (let ((context (make-terminal-context)))
    (with-frame (context 30 8)
      (lui:panel (lui:opt :id :pane :interactive-p t
                          :width (grow) :height (grow))
        (lui:label "Pane")))
    (let ((idle (render-terminal context :ansi t)))
      (assert (eq :pane (lui.frame::hit context 15 4)))
      (setf (context-hover context) :pane)
      (assert (equal idle (render-terminal context :ansi t)))
      (setf (context-active context) :pane)
      (assert (equal idle (render-terminal context :ansi t))))))

(fn test-scrollbar-rendering ()
  (let ((context (make-terminal-context)))
        (flet ((draw (show)
                 (lui:panel (lui:opt :id :pane :scroll-p t :scrollbar-p show
                                     :width (fixed 10) :height (fixed 8))
                   (dotimes (i 24) (lui:label (write-to-string i))))))
          (with-frame (context 10 8) (draw t))
          (let ((start (render-terminal context)))
            (assert (find #\█ start))
            (with-frame (context 10 8) (scroll-to :pane 0 99) (draw t))
            (assert (> (position #\█ (render-terminal context))
                      (position #\█ start))))
          (with-frame (context 10 8) (draw nil))
          (assert (null (find #\█ (render-terminal context)))))))

(fn test-text-rendering ()
  (let ((context (make-terminal-context)))
    (with-frame (context 5 10)
      (column (:width (grow))
        (lui.glass:label "ab cd ef")
        (lui.glass:label "next")))
    (assert (search (format nil "ab cd~%ef   ~%next ")
                    (render-terminal context)))
    (with-frame (context 20 5) (lui.motif:button :new "New"))
    (assert (search "[ New ]" (render-terminal context)))
    (with-frame (context 32 12)
      (table (:width (grow) :column-gap 1)
        (table-row () (table-cell (:column-span 2) (label "Header")))
        (table-row () (label "A") (button :edit "Edit"))))
    (assert (search "Header" (render-terminal context))))
  (assert (equal (text-lines (format nil "a~%~%b~%") 3)
                 '("a" "" "b" "")))
  (assert (equal (text-lines "longword ok" 3) '("longword" "ok"))))

(fn test-incremental-output ()
  #+unix (terminfo:set-terminal "xterm-direct")
  (let ((context (make-terminal-context))
        (screen (make-instance 'lui.terminal::terminal-screen)))
    (flet ((draw (text)
             (with-frame (context 40 3)
               (lui.glass:label text (lui:opt :width (fixed 40)))))
           (capture ()
             (with-output-to-string (stream)
               (let ((*terminal-io* stream))
                 (lui.terminal::display-frame context screen)))))
      (draw "ABCDEFGHIJ")
      (let ((first (capture)) (unchanged (capture)))
        (assert (search "ABCDEFGHIJ" first))
        (assert (not (search "ABCDEFGHIJ" unchanged)))
        (assert (< (length unchanged) (/ (length first) 4))))
      (draw "X")
      (let ((changed (capture)))
        (assert (find #\X changed))
        (assert (search "         " changed)))
      (assert (string= "X         "
                       (apply #'concatenate 'string
                              (loop :for column :below 10
                                    :collect (uncursed::cell-string
                                              (aref (uncursed::screen screen)
                                                    0 column)))))))))

(fn run-tests ()
  (test-text-rendering)
  (test-overlay)
  (test-terminal-overlap)
  (test-panel-input-style)
  (test-scrollbar-rendering)
  (test-incremental-output)
  (format t "Native terminal text, wrapping, ANSI overlays, overlap and scrollbars passed.~%")
  t)
