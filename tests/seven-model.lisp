(defpackage #:lui.tests.seven.model
  (:use #:cl #:lui.fn #:lui.seven.model)
  (:export #:run-tests))
(in-package #:lui.tests.seven.model)

(defvar *executed* nil)

(fn near ((left real) (right real))
  (< (abs (- left right)) 1.0d-9))

(fn test-input ()
  (assert (near 125 (parse-number "  +1.25e2  ")))
  (assert (near -3 (parse-number "-3.")))
  (assert (near 0.5 (parse-number ".5")))
  (assert (near 0.01 (parse-number "+1E-2")))
  (assert (zerop (parse-number "0")))
  (dolist (text '("" "+" "." "1e" "1e+" "1/2" "1x" "1d0"
                  "NaN" "Infinity" "1e999999" "1e309" "R99"
                  "#.(setf lui.tests.seven.model::*executed* t)"))
    (assert (null (parse-number text))))
  (assert (near 32 (temperature "0" :celsius)))
  (assert (near 100 (temperature "212" :fahrenheit)))
  (assert (null (temperature "invalid" :celsius)))
  (assert (= 20000229 (parse-date "29.02.2000")))
  (assert (= 20240229 (parse-date "29.02.2024")))
  (dolist (text '("29.02.1900" "31.04.2024" "01.13.2024" "01.01.0000"
                  "1.01.2024" "01/01/2024" "01.01.20xx"))
    (assert (null (parse-date text))))
  (assert (flight-valid-p "01.01.2024" "invalid"))
  (assert (flight-valid-p "01.01.2024" "01.01.2024" t))
  (assert (not (flight-valid-p "02.01.2024" "01.01.2024" t))))

(fn test-timer ()
  (let ((timer (make-timer :duration 2)))
    (advance-timer timer 0)
    (assert (= 1 (advance-timer timer 1)))
    (multiple-value-bind (elapsed running) (advance-timer timer 3)
      (assert (= elapsed 2))
      (assert (not running)))
    (advance-timer timer 20)
    (assert (= 2 (advance-timer timer 100 :duration 5)))
    (assert (= 3 (advance-timer timer 101)))
    ;; Lowering the duration stops without moving elapsed time backwards.
    (assert (= 3 (advance-timer timer 101 :duration 1)))
    (assert (= 1 (timer-fraction timer)))
    (assert (= 0 (advance-timer timer 200 :reset t)))
    (assert (= 1 (advance-timer timer 201)))
    (advance-timer timer 201 :duration 0 :reset t)
    (assert (= 1 (timer-fraction timer)))
    (assert (= 0 (advance-timer timer 250 :duration 5)))
    (assert (= 1 (advance-timer timer 251)))))

(fn test-crud ()
  (let* ((model (make-crud))
         (first (crud-create model "Ada" "Smith"))
         (second (crud-create model "Grace" "Stone")))
    (assert (equal (list first) (crud-filter model "Sm")))
    (assert (equal (list first second) (crud-filter model "S")))
    (assert (eq first (crud-select model (person-id first))))
    (assert (crud-update model (person-id first) "Ada" "Jones"))
    (assert (equal (list second) (crud-filter model "S")))
    (assert (crud-delete model (person-id first)))
    (assert (null (crud-selected model)))
    (assert (not (crud-delete model (person-id first))))
    (assert (> (person-id (crud-create model "New" "Person"))
               (person-id second)))))

(fn test-circles ()
  (let* ((model (make-circles))
         (first (circle-add model 0 0 10))
         (second (circle-add model 4 0 10)))
    (assert (eq second (circle-hit model 3 0)))
    (assert (null (circle-hit model -10 0)))
    (assert (circle-undo model))
    (assert (null (circle-find model (circle-id second))))
    (assert (circle-redo model))
    (circle-begin-adjust model (circle-id first))
    (circle-preview model 20)
    (circle-preview model 30)
    (assert (= 2 (length (circles-undo model))))
    (assert (circle-commit model))
    (assert (= 3 (length (circles-undo model))))
    (circle-undo model)
    (assert (= 10 (circle-radius first)))
    (circle-redo model)
    (assert (= 30 (circle-radius first)))
    (circle-undo model)
    (circle-begin-adjust model (circle-id first))
    (circle-preview model 10)
    (assert (not (circle-commit model)))
    (assert (= 1 (length (circles-redo model))))
    (circle-begin-adjust model (circle-id first))
    (circle-preview model 99)
    (circle-cancel model)
    (assert (= 10 (circle-radius first)))
    (assert (= 1 (length (circles-redo model))))
    (circle-redo model)
    (assert (= 30 (circle-radius first)))
    (circle-undo model)
    (circle-add model 50 50)
    (assert (null (circles-redo model)))
    (assert (not (circle-redo model)))
    (circle-begin-adjust model (circle-id first))
    (circle-preview model 10)
    (assert (not (circle-commit model)))))

(fn value-is ((model sheet) address (expected real))
  (let ((cell (sheet-cell model address)))
    (assert (null (cell-problem cell)))
    (assert (near expected (cell-value cell)))))

(fn test-formulas ()
  (let ((model (make-sheet)))
    (sheet-set model "A0" "2")
    (sheet-set model "A1" "3")
    (sheet-set model "B1" "4")
    (sheet-set model "C1" "=sum(mul(2,A0),A1:B1)")
    (value-is model "C1" 11)
    (sheet-set model "D1" "=SUM( B1 : a0 )")
    (value-is model "D1" 9)
    (sheet-set model "E1" "=prod(A0:B1)")
    (value-is model "E1" 0)
    (sheet-set model "E1" "=prod(A0,A1,B1)")
    (value-is model "E1" 24)
    (sheet-set model "E1" "=sum()")
    (value-is model "E1" 0)
    (sheet-set model "E1" "=prod()")
    (value-is model "E1" 1)
    (sheet-set model "E1" "=sub(div(12,3),mod(7,3))")
    (value-is model "E1" 3)
    (sheet-set model "E1" "0.125")
    (assert (near 0.125 (parse-number (cell-display (sheet-cell model "E1")))))
    (sheet-set model "A2" "label")
    (sheet-set model "B2" "=add(A2,7)")
    (value-is model "B2" 7)
    (assert (equal "label" (cell-display (sheet-cell model "A2"))))
    (dolist (entry '(("=sum(Z100)" :reference) ("=sum(AA0)" :reference)
                     ("=sum(A0)garbage" :parse) ("=sum(1,)" :parse)
                     ("=add(1)" :value) ("=unknown(A0)" :name)
                     ("=A0:B1" :value) ("=div(1,0)" :division)
                     ("=mod(1,0)" :division)
                     ("=mul(1e308,1e308)" :number)))
      (sheet-set model "Z99" (first entry))
      (assert (eq (second entry) (cell-problem (sheet-cell model "Z99")))))
    (multiple-value-bind (ast dependencies problem)
        (parse-formula (make-string 4097 :initial-element #\a))
      (declare (ignore ast dependencies))
      (assert (eq :parse problem)))
    (multiple-value-bind (ast dependencies problem)
        (parse-formula
         (concatenate 'string "="
                      (apply #'concatenate 'string
                             (make-list 65 :initial-element "sum("))
                      "1" (make-string 65 :initial-element #\))))
      (declare (ignore ast dependencies))
      (assert (eq :parse problem)))
    (sheet-set model "Z99" "=#.(setf *executed* t)")
    (assert (eq :parse (cell-problem (sheet-cell model "Z99"))))
    (sheet-set model "Z99" "#.(setf *executed* t)")
    (assert (null *executed*))
    (assert (null (cell-problem (sheet-cell model "Z99"))))
    (let ((source (copy-seq "text")))
      (sheet-set model "Z99" source)
      (setf (char source 0) #\X)
      (assert (equal "text" (cell-text (sheet-cell model "Z99"))))
      (assert (equal "text" (cell-value (sheet-cell model "Z99")))))))

(fn test-incremental-cells ()
  (let ((model (make-sheet)))
    (sheet-set model "A0" "1")
    (sheet-set model "B0" "=mul(A0,2)")
    (sheet-set model "C0" "=add(A0,3)")
    (sheet-set model "D0" "=add(B0,C0)")
    (sheet-set model "Z99" "unrelated")
    (let ((unrelated (cell-revision (sheet-cell model "Z99"))))
      (sheet-set model "A0" "2")
      (value-is model "D0" 9)
      (assert (equal '(0 1 2 3) (sheet-recomputed model)))
      (assert (= unrelated (cell-revision (sheet-cell model "Z99")))))
    ;; No redundant downstream evaluation after an unchanged intermediate.
    (sheet-set model "B0" "=sub(A0,A0)")
    (sheet-set model "C0" "=add(B0,1)")
    (sheet-set model "D0" "=C0")
    (sheet-set model "A0" "3")
    (assert (equal '(0 1) (sheet-recomputed model)))
    (value-is model "D0" 1)
    ;; Replacing a formula removes subscriptions to its previous inputs.
    (sheet-set model "B0" "10")
    (sheet-set model "A0" "4")
    (assert (equal '(0) (sheet-recomputed model)))
    (value-is model "D0" 11)
    (sheet-set model "A0" "4")
    (assert (null (sheet-recomputed model)))))

(fn test-cycles ()
  (let ((model (make-sheet)))
    (sheet-set model "A0" "1")
    (sheet-set model "B0" "=A0")
    (sheet-set model "C0" "=add(B0,1)")
    (sheet-set model "A0" "=B0")
    (dolist (address '("A0" "B0" "C0"))
      (assert (eq :cycle (cell-problem (sheet-cell model address)))))
    (sheet-set model "A0" "2")
    (value-is model "A0" 2)
    (value-is model "B0" 2)
    (value-is model "C0" 3)
    (sheet-set model "A0" "=div(1,0)")
    (assert (eq :division (cell-problem (sheet-cell model "C0"))))
    (sheet-set model "A0" "5")
    (value-is model "C0" 6)
    (sheet-set model "D0" "=D0")
    (assert (eq :cycle (cell-problem (sheet-cell model "D0"))))
    (sheet-set model "D0" "4")
    (value-is model "D0" 4)))

(fn test-full-sheet-chain ()
  (let ((model (make-sheet)))
    ;; References run opposite row-major order to catch recursive evaluators
    ;; that overflow on a valid chain spanning every cell in the sheet.
    (loop :for index :downfrom 2599 :to 0
          :do (sheet-set model index
                         (if (= index 2599) "1"
                             (format nil "=~A" (cell-address (1+ index))))))
    (sheet-set model "Z99" "2")
    (assert (= 2600 (length (sheet-recomputed model))))
    (loop :for index :below 2600 :do (value-is model index 2))))

(fn run-tests ()
  (test-input)
  (test-timer)
  (test-crud)
  (test-circles)
  (test-formulas)
  (test-incremental-cells)
  (test-cycles)
  (test-full-sheet-chain)
  (format t "7GUIs pure validation, timer, CRUD, circle history and Cells passed.~%")
  t)
