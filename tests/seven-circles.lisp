(defpackage #:lui.tests.seven.circles
  (:use #:cl #:lui.fn #:lui #:lui.layout #:lui.frame #:lui.terminal
        #:lui.seven.model)
  (:export #:run-tests))
(in-package #:lui.tests.seven.circles)

(fn run-tests ()
  (let* ((lui.example.seven.circles:*state*
           (lui.example.seven.circles:make-state))
         (model (lui.example.seven.circles:state-model
                 lui.example.seven.circles:*state*))
         (context (make-terminal-context)) (*unit* 2))
    (labels ((frame (&rest events)
               (with-frame (context 240 100 :events events)
                 (lui.example.seven.circles:draw)))
             (node (id)
               (let ((found nil))
                 (walk-elements (context-root context)
                                (lambda (node)
                                  (when (equal id (element-id node))
                                    (setf found node))))
                 found))
             (disabled (id)
               (lui.widgets:widget-disabled-p (element-content (node id))))
             (activate (id)
               (frame (make-event :kind :activate :id id))))
      (frame)
      (assert (disabled :circle-undo))
      (assert (disabled :circle-redo))
      (let* ((box (element-box (node :circle-canvas)))
             (x (+ (box-x box) 20)) (y (+ (box-y box) 20)))
        (frame (make-event :kind :press :x x :y y))
        (assert (= 1 (length (circles-items model))))
        (let ((circle (first (circles-items model))))
          (assert (= 10 (circle-x circle) (circle-y circle)))
          (frame (make-event :kind :press :x (+ x 30) :y y))
          (assert (= 2 (length (circles-items model))))
          (frame (make-event :kind :move :x x :y y))
          (let ((command (first (lui.widgets:widget-value
                                 (element-content (node :circle-canvas))))))
            (assert (= 20 (second command) (third command)))
            (assert (= 5 (fourth command)))
            (assert (equal "#c8c8c8" (sixth command))))
          ;; Pressing an existing circle never adds another.
          (frame (make-event :kind :press :x x :y y))
          (assert (= 2 (length (circles-items model))))
          (frame (make-event :kind :press :button :secondary :x x :y y))
          (assert (lui.example.seven.circles:modal-p))
          (assert (eq :circle-diameter (context-focus context)))
          (assert (disabled :circle-canvas))
          (assert (disabled :circle-undo))
          (assert (disabled :circle-redo))
          (frame (make-event :kind :change :id :circle-diameter :value 12))
          (frame (make-event :kind :change :id :circle-diameter :value 14))
          (assert (= 7 (circle-radius circle)))
          (assert (= 2 (length (circles-undo model))))
          (activate :circle-apply)
          (assert (not (lui.example.seven.circles:modal-p)))
          (frame)
          (assert (eq :circle-canvas (context-focus context)))
          (assert (= 3 (length (circles-undo model))))
          (frame)
          (activate :circle-undo)
          (assert (= 2.5 (circle-radius circle)))
          (activate :circle-redo)
          (assert (= 7 (circle-radius circle)))
          (frame (make-event :kind :press :button :secondary :x x :y y))
          (frame (make-event :kind :change :id :circle-diameter :value 18))
          (frame (make-event :kind :key :id :circle-diameter :key :escape))
          (assert (not (lui.example.seven.circles:modal-p)))
          (assert (= 7 (circle-radius circle)))
          (assert (= 3 (length (circles-undo model))))
          (activate :circle-undo)
          (activate :circle-undo)
          (assert (= 1 (length (circles-items model))))
          (activate :circle-redo)
          (activate :circle-redo)
          (assert (= 2 (length (circles-items model))))
          (assert (= 7 (circle-radius circle)))))))
  (format t "Circle Drawer scaling, hover, modal preview and history passed.~%")
  t)
