(defpackage #:lui.example.showcase
  (:use #:cl #:lui #:lui.layout #:lui.frame)
  (:export #:main #:draw))
(in-package #:lui.example.showcase)

(defvar *volume* 0.5)
(defvar *playing* nil)
(defvar *name* "Library")

(defun draw ()
  (row (:width (grow) :height (grow) :padding (units 2) :gap (units 2))
    (lui.glass:panel (:id :sidebar :width (percent 0.3) :height (grow)
                     :padding (units 2) :gap (units 1) :scroll-p t)
      (lui.glass:label "Library")
      (setf *name* (lui.glass:text-field :search *name* :width (grow)))
      (lui.glass:button :home "Listen now" :width (grow))
      (lui.glass:button :browse "Browse" :width (grow))
      (lui.glass:button :radio "Radio" :width (grow))
      (lui.glass:label "Volume")
      (setf *volume* (lui.glass:slider :volume *volume* :width (grow)))
      (setf *playing* (lui.glass:checkbox :playing *playing* "Playing")))
    (column (:width (grow) :height (grow) :gap (units 2))
      (lui.glass:label "Good evening")
      (lui.glass:label "One Lisp UI, native rendering on every backend.")
      (row (:width (grow) :height (grow) :gap (units 1))
        (lui.glass:panel (:width (grow) :height (grow)
                         :background "#ed6280" :opacity 1
                         :padding (units 2))
          (lui.glass:label "Sunrise"))
        (lui.glass:panel (:width (grow) :height (grow)
                         :background "#269dc5" :opacity 1
                         :padding (units 2))
          (lui.glass:label "Deep water")))
      (lui.glass:panel (:width (grow) :direction :row :gap (units 1)
                       :padding (units 1))
        (lui.glass:button :previous "Previous")
        (when (lui.glass:button :play (if *playing* "Pause" "Play"))
          (setf *playing* (not *playing*)))
        (lui.glass:button :next "Next"))
      (lui.motif:panel (:width (grow) :direction :row :gap (units 1)
                       :padding (units 1))
        (lui.motif:label "Motif collection")
        (lui.motif:button :settings "Settings")))))

(defun main ()
  (run #'draw :title "LUI style showcase"))
