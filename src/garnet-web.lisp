(defpackage #:lui.garnet.web
  (:use #:cl #:lui.fn #:lui.layout #:lui.widgets #:lui.web.style))
(in-package #:lui.garnet.web)

(fn apply-style (dom (widget widget) (node element))
  (let* ((kind (widget-kind widget)) (box (element-box node))
         (clip (element-clip node))
         (control (if (eq kind :checkbox)
                      (jscl/ffi:oget dom "firstElementChild") dom)))
    (style dom "border-radius" "0")
    (style dom "backdrop-filter" "none")
    (when (framed-p widget)
      (style dom "border" "1px solid #000"))
    (when (framed-p widget)
      (style dom "background" (widget-background widget))
      (style dom "box-shadow" "none"))
    (when (member kind '(:button :tab :panel))
      (let ((window-p (window-panel-p widget node)))
        (style dom "border" (if window-p "none" "1px solid #000"))
        (style dom "background"
               (if (or window-p (eq kind :panel))
                   (widget-background widget)
                   "linear-gradient(#fff,#fff) 4px 4px / calc(100% - 8px) calc(100% - 8px) no-repeat,repeating-conic-gradient(#000 0% 25%,#fff 0% 50%) 0 0 / 2px 2px"))
        (style dom "box-shadow"
               (if window-p "none"
                   "inset 0 0 0 1px #000,4px 4px 0 #000"))
        (unless window-p
          (when (member kind '(:button :tab))
            (style dom "padding" "3px 9px")
            (style dom "text-align" "center"))
          (style dom "width" (px (max 0 (- (box-width box) 4))))
          (style dom "height" (px (max 0 (- (box-height box) 4))))
          (style dom "clip-path"
                 (format nil "inset(~A ~A ~A ~A)"
                         (px (- (box-y clip) (box-y box)))
                         (px (- (+ (box-x box) (box-width box))
                                (+ (box-x clip) (box-width clip)) 4))
                         (px (- (+ (box-y box) (box-height box))
                                (+ (box-y clip) (box-height clip)) 4))
                         (px (- (box-x clip) (box-x box))))))))
    (when (and (eq kind :tab) (widget-value widget))
      (style dom "background" "#000")
      (style dom "color" "#fff"))
    (when (eq kind :scrollbar)
      (let* ((width (box-width box)) (bounds (scrollbar-thumb node))
             (inset (min 1 (/ (min width (box-height bounds)) 4)))
             (thumb (jscl/ffi:oget dom "firstElementChild")))
        (style dom "background"
               "repeating-conic-gradient(#000 0% 25%,#fff 0% 50%) 0 0 / 2px 2px")
        (style dom "box-shadow" "inset 0 0 0 1px #000")
        (style thumb "left" (px inset))
        (style thumb "top" (px (+ (- (box-y bounds) (box-y box)) inset)))
        (style thumb "height"
               (px (max 0 (- (box-height bounds) (* 2 inset)))))
        (style thumb "width" (px (- width (* 2 inset))))
        (style thumb "background" (widget-background widget))
        (style thumb "border" "1px solid #000000")))
    (when (eq kind :text-field)
      (style dom "padding" "5px"))
    (when (eq kind :checkbox)
      (attribute dom "class" "lui-check lui-garnet-check")
      (style dom "padding" "3px 4px 3px 12px")
      (style dom "gap" "12px")
      (style dom "border" "none")
      (style dom "background" "transparent")
      (style dom "flex-direction" "row-reverse")
      (style dom "justify-content" "flex-end")
      (style control "width" "20px")
      (style control "height" "20px"))
    (when (eq kind :slider) (style dom "--lui-thumb-radius" "0"))))

(add-sheet :garnet
 #j"[data-lui-surface=garnet].lui-control:hover:enabled{filter:none;background:#eee!important}[data-lui-surface=garnet].lui-control:active:enabled{filter:none;transform:translate(4px,4px);box-shadow:inset 0 0 0 1px #000!important}.lui-garnet-check:active input:enabled,.lui-garnet-check input:active:enabled{filter:none;transform:translate(4px,4px);box-shadow:0 0 0 #000}.lui-garnet-check input{appearance:none;transition:none;background:linear-gradient(#fff,#fff) 3px 3px / calc(100% - 6px) calc(100% - 6px) no-repeat,repeating-conic-gradient(#000 0% 25%,#fff 0% 50%) 0 0 / 2px 2px;border:1px solid #000;border-radius:0;box-shadow:4px 4px 0 #000;display:grid;place-content:center}.lui-garnet-check input:checked::after{content:\"\";width:10px;height:10px;background:linear-gradient(45deg,transparent 44%,currentColor 44%,currentColor 56%,transparent 56%),linear-gradient(-45deg,transparent 44%,currentColor 44%,currentColor 56%,transparent 56%)}[data-lui-surface=garnet].lui-range::-webkit-slider-runnable-track{height:12px;border:1px solid #000;border-radius:0;background:repeating-conic-gradient(#000 0% 25%,#fff 0% 50%) 0 0 / 2px 2px}[data-lui-surface=garnet].lui-range::-webkit-slider-thumb{width:18px;height:18px;margin-top:-4px;border:1px solid #000;border-radius:0;background:#fff;box-shadow:3px 3px 0 #000}[data-lui-surface=garnet].lui-range::-moz-range-track{height:12px;border:1px solid #000;border-radius:0;background:repeating-conic-gradient(#000 0% 25%,#fff 0% 50%) 0 0 / 2px 2px}[data-lui-surface=garnet].lui-range::-moz-range-progress{background:transparent}[data-lui-surface=garnet].lui-range::-moz-range-thumb{width:18px;height:18px;border:1px solid #000;border-radius:0;background:#fff;box-shadow:3px 3px 0 #000}")
(setf (lui:toolkit-web-style :garnet) #'apply-style)
